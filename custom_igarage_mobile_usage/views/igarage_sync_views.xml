<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_igarage_usage_sync_log_list" model="ir.ui.view">
        <field name="name">igarage.usage.sync.log.list</field>
        <field name="model">igarage.usage.sync.log</field>
        <field name="arch" type="xml">
            <list string="ประวัติการดึงข้อมูล" create="false" edit="false"
                  decoration-danger="state == 'error'" decoration-muted="state == 'skip'">
                <field name="create_date" string="ดึงเมื่อ"/>
                <field name="kind"/>
                <field name="trigger"/>
                <field name="rows"/>
                <field name="duration"/>
                <field name="message"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="view_igarage_usage_sync_log_form" model="ir.ui.view">
        <field name="name">igarage.usage.sync.log.form</field>
        <field name="model">igarage.usage.sync.log</field>
        <field name="arch" type="xml">
            <form string="ผลการดึงข้อมูล" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="create_date" string="ดึงเมื่อ"/>
                        <field name="kind"/>
                        <field name="trigger"/>
                        <field name="state" widget="badge"/>
                        <field name="rows"/>
                        <field name="duration"/>
                        <field name="message" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_igarage_usage_sync_log" model="ir.actions.act_window">
        <field name="name">ประวัติการดึงข้อมูล</field>
        <field name="res_model">igarage.usage.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_igarage_usage_logfile_list" model="ir.ui.view">
        <field name="name">igarage.usage.logfile.list</field>
        <field name="model">igarage.usage.logfile</field>
        <field name="arch" type="xml">
            <list string="ไฟล์ log ที่ประมวลผลแล้ว" create="false" edit="false">
                <field name="create_date" string="ประมวลผลเมื่อ"/>
                <field name="name"/>
                <field name="first_ts"/>
                <field name="last_ts"/>
                <field name="api_calls" sum="รวม"/>
                <field name="app_writes" sum="รวม"/>
                <field name="unknown_keys" sum="รวม"/>
                <field name="size" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_igarage_usage_logfile" model="ir.actions.act_window">
        <field name="name">ไฟล์ log ที่ประมวลผลแล้ว</field>
        <field name="res_model">igarage.usage.logfile</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_igarage_usage_sync_now" model="ir.actions.server">
        <field name="name">ดึงข้อมูลตอนนี้</field>
        <field name="model_id" ref="model_igarage_usage_sync"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_now()</field>
        <field name="groups_id" eval="[(4, ref('group_igarage_usage_manager'))]"/>
    </record>

</odoo>
