<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_igarage_usage" model="ir.module.category">
        <field name="name">iGarage</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_igarage_usage_user" model="res.groups">
        <field name="name">ดูรายงานการใช้แอปลงเวลา</field>
        <field name="category_id" ref="module_category_igarage_usage"/>
    </record>

    <record id="group_igarage_usage_manager" model="res.groups">
        <field name="name">ผู้ดูแล (ตั้งค่า / สั่งดึงข้อมูล)</field>
        <field name="category_id" ref="module_category_igarage_usage"/>
        <field name="implied_ids" eval="[(4, ref('group_igarage_usage_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
