<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- สืบทอด (Inherit) หน้าจอ Form View เดิมของ account.move -->
    <record id="view_move_form_inherit_garage" model="ir.ui.view">
        <field name="name">account.move.form.inherit.garage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <!-- หาตำแหน่งฟิลด์ ref (Customer Reference) แล้วแทรกฟิลด์ของเราต่อท้าย -->
            <xpath expr="//field[@name='ref']" position="after">
                <!-- ใส่ invisible เพื่อให้แสดงเฉพาะบิล/ใบเสร็จฝั่งขาย (ไม่แสดงในบิลฝั่งซื้อ) -->
                <field name="repair_job_no" invisible="move_type != 'out_receipt'"/>
                <field name="vehicle_brand" invisible="move_type != 'out_receipt'"/>
                <field name="license_plate" invisible="move_type != 'out_receipt'"/>
                <field name="custom_payment_method" invisible="move_type != 'out_receipt'"/>
            </xpath>
            
        </field>
    </record>
</odoo>
