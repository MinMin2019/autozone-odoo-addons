    <!-- ========================================== -->
    <!-- 2. ACTION: Receipt Voucher (RV)            -->
    <!-- ========================================== -->
    <record id="action_move_rv" model="ir.actions.act_window">
        <field name="name">ใบสำคัญรับ (RV)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('journal_id.code', '=', 'RV')]</field>
        <field name="context"
            eval="{'default_journal_id': ref('thai_accounting_vouchers.journal_rv'), 'default_move_type': 'entry', 'search_default_posted': 1, 'default_x_journal_code': 'RV' }" />
        <field name="view_id" ref="account.view_move_tree" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างใบสำคัญรับใหม่
            </p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- 3. ACTION: Journal Voucher (JV)            -->
    <!-- ========================================== -->

    <!-- List view เฉพาะเมนู JV: เพิ่มคอลัมน์ Description (x_description)
         แยกเป็น primary view เพื่อไม่กระทบหน้า Journal Entries อื่น -->
    <record id="view_move_tree_jv" model="ir.ui.view">
        <field name="name">account.move.list.jv</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="x_description" string="Description" optional="show" />
            </field>
        </field>
    </record>

    <record id="action_move_jv" model="ir.actions.act_window">
        <field name="name">ใบสำคัญทั่วไป (JV)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('journal_id.code', '=', 'JV')]</field>
        <field name="context"
            eval="{'default_journal_id': ref('thai_accounting_vouchers.journal_jv'), 'default_move_type': 'entry', 'search_default_posted': 1, 'default_x_journal_code': 'JV' }" />
        <field name="view_id" ref="thai_accounting_vouchers.view_move_tree_jv" />
    </record>


    <!-- ========================================== -->
    <!-- 4. VIEW: Inherit Form View ของ account.move -->
    <!-- ========================================== -->
    <record id="view_move_form_thai_voucher_inherit" model="ir.ui.view">
        <field name="name">account.move.form.thai.voucher.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='ref']" position="after">
                <!-- ต้องใส่ field นี้ไว้ใน view ด้วย (ซ่อนไว้ก็ได้) เพื่อให้ Javascript อ่านค่าได้ -->
                <field name="x_journal_code" invisible="1" />

                <!-- 1. Cheque No: แสดงทั้ง PV และ RV (ซ่อนถ้าไม่ใช่ทั้งคู่) -->
                <!-- แปล: ถ้า (ไม่ใช่ PV) และ (ไม่ใช่ RV) ให้ซ่อน -->
                <field name="x_cheque_number" invisible="x_journal_code and 'PV' not in x_journal_code and 'RV' not in x_journal_code" />

                <!-- 2. Payment Date: แสดงเฉพาะ PV (จ่าย) -->
                <field name="x_payment_date" invisible="x_journal_code and 'PV' not in x_journal_code" />

                <!-- 3. Receipt Date: แสดงเฉพาะ RV (รับ) -->
                <field name="x_receipt_date" invisible="x_journal_code and 'RV' not in x_journal_code" />

                <!-- 4. Description: แสดงเฉพาะ JV (ทั่วไป) ใช้พิมพ์ รายละเอียดรายการ ในรายงาน -->
                <field name="x_description" invisible="x_journal_code and 'JV' not in x_journal_code" />

                <!-- 5. PO No: เฉพาะ Vendor Bill คีย์เอง ใช้พิมพ์ อ้างถึง/Ref. ในใบสำคัญการตั้งหนี้ -->
                <field name="x_po_number" invisible="move_type not in ('in_invoice', 'in_refund')" />

            </xpath>

            <!-- ซ่อน Auto-Complete (จากบิลเก่า) ของ module account -->
            <label name="invoice_vendor_bill_id_label" position="attributes">
                <attribute name="invisible">1</attribute>
            </label>
            <field name="invoice_vendor_bill_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

        </field>
    </record>

    <!-- ========================================== -->
    <!-- 4.1 VIEW: ซ่อนช่อง Auto-Complete (PO) ของ purchase -->
    <!-- ========================================== -->
    <record id="view_move_form_hide_autocomplete" model="ir.ui.view">
        <field name="name">account.move.form.hide.autocomplete</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="purchase.view_move_form_inherit_purchase" />
        <field name="arch" type="xml">
            <label for="purchase_vendor_bill_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </label>
            <field name="purchase_vendor_bill_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>


    <!-- ========================================== -->
    <!-- MENU ITEMS (วางไว้ใต้เมนู Accounting)         -->
    <!-- ========================================== -->

    <!-- สร้าง Parent Menu ใหม่ชื่อ "Vouchers" (ถ้าต้องการ) -->
    <menuitem id="menu_finance_vouchers" name="Vouchers (สมุดรายวัน)"
        parent="account.menu_finance_entries" sequence="1" />

    <!-- เมนูย่อย -->
