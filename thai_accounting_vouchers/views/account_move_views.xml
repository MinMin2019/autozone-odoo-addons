        <!-- parent="menu_finance_vouchers" sequence="10" /> -->

    <menuitem id="menu_action_move_rv" name="ใบสำคัญรับ (RV)" action="action_move_rv"
        parent="menu_finance_vouchers" sequence="20" />

    <menuitem id="menu_action_move_jv" name="ใบสำคัญทั่วไป (JV)" action="action_move_jv"
        parent="menu_finance_vouchers" sequence="30" />

</odoo>