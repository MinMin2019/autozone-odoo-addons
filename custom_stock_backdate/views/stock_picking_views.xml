<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_backdate" model="ir.ui.view">
        <field name="name">stock.picking.form.backdate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- scheduled_date อยู่ใน div.o_row ที่ใช้ label ร่วมกัน
                 ต้องแทรกระดับลูกของ group ถึงจะได้ label ของตัวเอง -->
            <field name="date_deadline" position="after">
                <field name="backdate" readonly="state in ('done', 'cancel')"/>
            </field>
            <xpath expr="//header" position="inside">
                <button name="action_fix_backdate" type="object"
                        string="แก้วันที่รับจริง"
                        groups="account.group_account_manager"
                        invisible="state != 'done'"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_list_backdate" model="ir.ui.view">
        <field name="name">stock.picking.list.backdate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <!-- ต้นฉบับซ่อน scheduled_date เมื่อใบ done/cancel และใช้ widget
                 remaining_days ที่แสดงเป็น "87 days ago" แทนวันจริง
                 ปลดทั้งสองอย่างเพื่อให้เทียบวันกำหนดการ/วันมีผล/วันรับจริงได้ -->
            <field name="scheduled_date" position="attributes">
                <attribute name="widget"/>
                <attribute name="invisible"/>
            </field>
            <field name="date_done" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="date_done" position="after">
                <field name="backdate" optional="show" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
