<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เพิ่มคอลัมน์รูปสินค้าในแท็บ Operations ของใบโอนย้าย/รับเข้า/ส่งออก -->
    <record id="view_picking_form_product_image" model="ir.ui.view">
        <field name="name">stock.picking.form.product.image</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']"
                   position="after">
                <field name="product_image" widget="image"
                       options="{'size': [45, 45]}" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
