<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เพิ่มคอลัมน์รูปสินค้าในแท็บรายการคำสั่งซื้อของใบสั่งขาย -->
    <record id="view_order_form_product_image" model="ir.ui.view">
        <field name="name">sale.order.form.product.image</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']"
                   position="after">
                <field name="product_image" widget="image"
                       options="{'size': [45, 45]}" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
