<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_employee_loan_company" model="ir.rule">
        <field name="name">Employee Loan: multi-company</field>
        <field name="model_id" ref="model_hr_employee_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_employee_loan_line_company" model="ir.rule">
        <field name="name">Employee Loan Line: multi-company</field>
        <field name="model_id" ref="model_hr_employee_loan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
