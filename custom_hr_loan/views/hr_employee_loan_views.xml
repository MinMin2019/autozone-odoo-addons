<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_loan_form" model="ir.ui.view">
        <field name="name">hr.employee.loan.form</field>
        <field name="model">hr.employee.loan</field>
        <field name="arch" type="xml">
            <form string="เงินกู้พนักงาน">
                <header>
                    <button name="action_approve" string="อนุมัติ + สร้างตารางงวด" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="ปิดยอด" type="object"
                            class="oe_highlight" invisible="state != 'running'"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state not in ('draft', 'running')"
                            confirm="ยืนยันยกเลิกเงินกู้รายการนี้?"/>
                    <button name="action_draft" string="ดึงกลับเป็นร่าง" type="object"
                            invisible="state not in ('running', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="state in ('done', 'cancel')"
                                   placeholder="เว้นว่าง = รันเลขอัตโนมัติ LCปี/NNN"/></h1>
                    </div>
                    <group>
                        <group string="พนักงาน">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="registration_number"/>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="เงินกู้">
                            <field name="date_loan" readonly="state != 'draft'"/>
                            <field name="principal_amount" readonly="state != 'draft'"/>
                            <field name="installment_amount" readonly="state != 'draft'"/>
                            <field name="date_first_due" readonly="state != 'draft'"/>
                            <field name="installment_count" invisible="state != 'draft'"/>
                            <field name="interest_rate" readonly="state != 'draft'"/>
                            <field name="interest_method" readonly="state != 'draft'"
                                   invisible="not interest_rate"/>
                            <field name="interest_total" invisible="not interest_rate"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="ยอดคงเหลือ" invisible="state == 'draft'">
                            <field name="amount_paid"/>
                            <field name="amount_remaining" class="fw-bold"/>
                            <field name="interest_received" invisible="not interest_rate"/>
                        </group>
                        <group string="อ้างอิงบัญชี">
                            <field name="move_id" groups="account.group_account_invoice"/>
                            <field name="note" nolabel="0"/>
                        </group>
                    </group>
                    <notebook invisible="state == 'draft'">
                        <page string="ตารางงวดผ่อน" name="installments">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="state in ('paid', 'paid_manual')"
                                      decoration-info="state == 'in_slip'">
                                    <field name="number"/>
                                    <field name="date_due"
                                           readonly="state in ('in_slip', 'paid', 'paid_manual')"/>
                                    <field name="amount"
                                           readonly="state in ('in_slip', 'paid', 'paid_manual')"/>
                                    <field name="amount_interest"
                                           readonly="state in ('in_slip', 'paid', 'paid_manual')"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                    <field name="payslip_id"/>
                                    <field name="manual_paid"
                                           readonly="state in ('in_slip', 'paid')"/>
                                    <field name="manual_note"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_loan_list" model="ir.ui.view">
        <field name="name">hr.employee.loan.list</field>
        <field name="model">hr.employee.loan</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="registration_number" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="date_loan"/>
                <field name="principal_amount" sum="รวม"/>
                <field name="amount_paid" sum="รวม"/>
                <field name="amount_remaining" sum="รวม"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'running'"
                       decoration-success="state == 'done'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_loan_search" model="ir.ui.view">
        <field name="name">hr.employee.loan.search</field>
        <field name="model">hr.employee.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="registration_number"/>
                <filter name="filter_running" string="กำลังผ่อน" domain="[('state', '=', 'running')]"/>
                <filter name="filter_done" string="ปิดยอดแล้ว" domain="[('state', '=', 'done')]"/>
                <filter name="filter_draft" string="ร่าง" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="พนักงาน" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="แผนก" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_loan" model="ir.actions.act_window">
        <field name="name">ทะเบียนเงินกู้พนักงาน</field>
        <field name="res_model">hr.employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างเงินกู้สวัสดิการรายการแรก</p>
            <p>บันทึกเงินต้น ยอดหักต่อเดือน แล้วกดอนุมัติ ระบบจะสร้างตารางงวดให้
               จากนั้นไปที่ Payslip Batch แล้วกดปุ่ม "หักเงินกู้พนักงาน" ทุกเดือน</p>
        </field>
    </record>

    <!-- งวดผ่อนทุกสัญญาในมุมมองเดียว ไว้กระทบยอดกับ GL รายเดือน -->
    <record id="view_hr_employee_loan_line_list" model="ir.ui.view">
        <field name="name">hr.employee.loan.line.list</field>
        <field name="model">hr.employee.loan.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-success="state in ('paid', 'paid_manual')"
                  decoration-info="state == 'in_slip'">
                <field name="loan_id"/>
                <field name="employee_id"/>
                <field name="number"/>
                <field name="date_due"/>
                <field name="amount" sum="รวม"/>
                <field name="amount_interest" sum="รวม"/>
                <field name="amount_total" sum="รวม"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('paid', 'paid_manual')"
                       decoration-info="state == 'in_slip'"/>
                <field name="payslip_id"/>
                <field name="manual_note" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_loan_line_search" model="ir.ui.view">
        <field name="name">hr.employee.loan.line.search</field>
        <field name="model">hr.employee.loan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="loan_id"/>
                <filter name="filter_open" string="รอหัก" domain="[('state', '=', 'open')]"/>
                <filter name="filter_paid" string="หักแล้ว"
                        domain="[('state', 'in', ('paid', 'paid_manual'))]"/>
                <separator/>
                <filter name="filter_date_due" string="กำหนดหัก" date="date_due"/>
                <group expand="0" string="Group By">
                    <filter name="group_month" string="เดือนที่กำหนดหัก"
                            context="{'group_by': 'date_due:month'}"/>
                    <filter name="group_employee" string="พนักงาน"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_loan_line" model="ir.actions.act_window">
        <field name="name">งวดผ่อนทั้งหมด</field>
        <field name="res_model">hr.employee.loan.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_month': 1}</field>
    </record>

</odoo>
