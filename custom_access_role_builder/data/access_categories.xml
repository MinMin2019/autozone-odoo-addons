<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- หมวดของ group ที่ generate: Roles (โผล่ในฟอร์ม user), Capabilities (อิฐ, ภายใน)
         noupdate=0 เพื่อให้เปลี่ยนชื่อได้ตอน -u -->
    <record id="module_category_arb_roles" model="ir.module.category">
        <field name="name">Access: Roles</field>
        <field name="description">Job roles generated by Role Builder — assign to users</field>
        <field name="sequence">50</field>
    </record>

    <record id="module_category_arb_caps" model="ir.module.category">
        <field name="name">Access: Capabilities</field>
        <field name="description">Capability bricks generated by Role Builder — do not assign directly</field>
        <field name="sequence">51</field>
    </record>

</odoo>
