<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_export_xlsx" model="ir.ui.view">
        <field name="name">stock.picking.form.export.xlsx</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_export_xlsx" type="object"
                        string="Export Excel" icon="fa-file-excel-o"
                        class="btn-secondary"
                        help="ส่งออกหัวใบและรายการสินค้าของใบนี้เป็นไฟล์ Excel"/>
            </xpath>
        </field>
    </record>
</odoo>
