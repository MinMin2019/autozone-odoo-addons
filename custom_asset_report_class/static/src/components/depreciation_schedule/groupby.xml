<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="account_asset.DepreciationScheduleGroupBy" t-inherit-mode="extension">
        <!-- ป้ายบนปุ่มเมื่อเลือกจัดกลุ่มตาม Analytic อยู่ -->
        <xpath expr="//button/t[contains(@t-elif, 'asset_group_id')]" position="after">
            <t t-elif="controller.options.assets_grouping_field === 'analytic_distribution'">
                Group by Analytic
            </t>
        </xpath>
        <!-- ตัวเลือกใน dropdown -->
        <xpath expr="//DropdownItem[contains(@onSelected, 'asset_group_id')]" position="after">
            <DropdownItem
                class="{ 'selected': controller.options.assets_grouping_field === 'analytic_distribution' }"
                onSelected="() => this.filterClicked({ optionKey: 'assets_grouping_field', optionValue: 'analytic_distribution', reload: true})"
            >
                Group by Analytic
            </DropdownItem>
        </xpath>
    </t>
</templates>
