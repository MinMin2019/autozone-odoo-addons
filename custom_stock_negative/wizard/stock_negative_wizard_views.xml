<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sn_wizard_form" model="ir.ui.view">
        <field name="name">stock.negative.wizard.form</field>
        <field name="model">stock.negative.wizard</field>
        <field name="arch" type="xml">
            <form string="สต็อกติดลบ">
                <group>
                    <group string="โหมด / วันที่">
                        <field name="mode" widget="radio"/>
                        <field name="date_from" invisible="mode != 'events'" required="mode == 'events'"/>
                        <field name="date_to"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group string="ขอบเขต">
                        <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="ทุกสาขา"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="ทุกหมวด"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="ทุกสินค้า"/>
                    </group>
                </group>
                <group string="ตัวเลือก">
                    <field name="split_by_location"/>
                    <field name="include_non_storable"/>
                </group>
                <div class="text-muted small">
                    ติดลบ ณ วันที่ = สินค้าที่ยอดคงเหลือต่ำกว่า 0 พร้อมเอกสารที่ทำให้ติดลบและของค้างรับที่กำลังเข้ามา
                    &#160;|&#160; ประวัติ = ทุกรายการจ่ายออกในช่วงที่ทำให้ยอดต่ำกว่า 0 (แม้ตอนนี้แก้แล้ว) ใช้ดูว่ากระบวนการไหนสร้างปัญหา
                </div>
                <footer>
                    <button name="action_view" string="ดูรายงาน" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Excel" type="object" class="btn-secondary"/>
                    <button name="action_print_pdf" string="PDF" type="object" class="btn-secondary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sn_wizard" model="ir.actions.act_window">
        <field name="name">สต็อกติดลบ (Negative Stock)</field>
        <field name="res_model">stock.negative.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sn" name="สต็อกติดลบ (Negative Stock)"
              parent="stock.menu_warehouse_report" action="action_sn_wizard" sequence="49"/>

    <record id="view_sn_line_list" model="ir.ui.view">
        <field name="name">stock.negative.line.list</field>
        <field name="model">stock.negative.line</field>
        <field name="arch" type="xml">
            <list string="สต็อกติดลบ" create="false" edit="false" delete="false"
                  decoration-success="covered" decoration-danger="not covered and days_negative &gt;= 30">
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" optional="show" column_invisible="not context.get('split_by_location')"/>
                <field name="default_code"/>
                <field name="product_name"/>
                <field name="categ_id" optional="hide"/>
                <field name="uom_id"/>
                <field name="date" widget="date" optional="show" column_invisible="context.get('mode') != 'events'"/>
                <field name="qty_before" optional="hide"/>
                <field name="move_qty" optional="hide"/>
                <field name="qty"/>
                <field name="unit_cost" optional="hide"/>
                <field name="value" sum="รวม"/>
                <field name="neg_since" optional="show" column_invisible="context.get('mode') == 'events'"/>
                <field name="days_negative" optional="show" column_invisible="context.get('mode') == 'events'"/>
                <field name="kind"/>
                <field name="reference"/>
                <field name="origin" optional="hide"/>
                <field name="counterpart" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="pending_in_qty" optional="show" column_invisible="context.get('mode') == 'events'"/>
                <field name="pending_in_refs" optional="hide" column_invisible="context.get('mode') == 'events'"/>
                <field name="covered" optional="show" column_invisible="context.get('mode') == 'events'"/>
                <field name="advice" optional="hide"/>
                <field name="product_id" column_invisible="1"/>
                <field name="picking_id" column_invisible="1"/>
                <button name="action_open_picking" type="object" icon="fa-external-link" title="เปิดเอกสารที่ทำให้ติดลบ" invisible="not picking_id"/>
                <button name="action_open_pending" type="object" icon="fa-truck" title="เปิดของค้างรับ" invisible="not pending_in_qty"/>
            </list>
        </field>
    </record>

    <record id="view_sn_line_search" model="ir.ui.view">
        <field name="name">stock.negative.line.search</field>
        <field name="model">stock.negative.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="default_code"/>
                <field name="product_name"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="categ_id"/>
                <field name="reference"/>
                <field name="user_id"/>
                <filter name="uncovered" string="ไม่มีของค้างรับมาแก้" domain="[('covered', '=', False)]"/>
                <filter name="covered" string="มีของค้างรับพอแก้" domain="[('covered', '=', True)]"/>
                <filter name="over30" string="ติดลบเกิน 30 วัน" domain="[('days_negative', '&gt;=', 30)]"/>
                <filter name="big" string="มูลค่าเกิน 1,000 บาท" domain="[('value', '&lt;=', -1000)]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_warehouse" string="สาขา / คลัง" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_kind" string="ประเภทรายการ" context="{'group_by': 'kind'}"/>
                    <filter name="group_categ" string="หมวดสินค้า" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_user" string="ผู้ทำ" context="{'group_by': 'user_id'}"/>
                    <filter name="group_product" string="สินค้า" context="{'group_by': 'product_id'}"/>
                    <filter name="group_month" string="เดือน" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_sn_line_pivot" model="ir.ui.view">
        <field name="name">stock.negative.line.pivot</field>
        <field name="model">stock.negative.line</field>
        <field name="arch" type="xml">
            <pivot string="สต็อกติดลบ" disable_linking="1">
                <field name="warehouse_id" type="row"/>
                <field name="kind" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sn_line_graph" model="ir.ui.view">
        <field name="name">stock.negative.line.graph</field>
        <field name="model">stock.negative.line</field>
        <field name="arch" type="xml">
            <graph string="สต็อกติดลบ" type="bar">
                <field name="warehouse_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sn_line_form" model="ir.ui.view">
        <field name="name">stock.negative.line.form</field>
        <field name="model">stock.negative.line</field>
        <field name="arch" type="xml">
            <form string="สต็อกติดลบ" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title"><h2><field name="name" readonly="1"/></h2></div>
                    <group>
                        <group string="สินค้า / ที่">
                            <field name="product_id" readonly="1"/>
                            <field name="categ_id" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="location_id" readonly="1" invisible="not location_id"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group string="ยอด">
                            <field name="qty" readonly="1"/>
                            <field name="unit_cost" readonly="1"/>
                            <field name="value" readonly="1"/>
                            <field name="neg_since" readonly="1"/>
                            <field name="days_negative" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="เอกสารที่ทำให้ติดลบ">
                            <field name="date" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="reference" readonly="1"/>
                            <field name="origin" readonly="1"/>
                            <field name="counterpart" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="qty_before" readonly="1"/>
                            <field name="move_qty" readonly="1"/>
                            <field name="picking_id" invisible="1"/>
                            <button name="action_open_picking" type="object" string="เปิดเอกสาร" class="btn-secondary" invisible="not picking_id"/>
                        </group>
                        <group string="ทางแก้">
                            <field name="pending_in_qty" readonly="1"/>
                            <field name="pending_in_refs" readonly="1"/>
                            <field name="covered" readonly="1"/>
                            <field name="advice" readonly="1"/>
                            <button name="action_open_pending" type="object" string="เปิดของค้างรับ" class="btn-secondary" invisible="not pending_in_qty"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
