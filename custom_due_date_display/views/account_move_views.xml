<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ฟอร์มมาตรฐานซ่อน Due Date ทันทีที่เลือก Payment Terms (สลับกันแสดง)
         โมดูลนี้เพิ่มแถว Due Date แบบอ่านอย่างเดียวต่อท้าย เฉพาะตอนที่มีเทอม
         เพื่อให้เห็นทั้งชื่อเทอมและวันครบกำหนดที่ระบบคำนวณพร้อมกัน -->
    <record id="view_move_form_due_date_display" model="ir.ui.view">
        <field name="name">account.move.form.due.date.display</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <label for="invoice_date_due"
                       invisible="not invoice_payment_term_id or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                <field name="invoice_date_due" nolabel="1" readonly="1" force_save="1"
                       invisible="not invoice_payment_term_id or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
            </xpath>
        </field>
    </record>

    <!-- List view มาตรฐานใช้ widget remaining_days แสดง Due Date เป็นข้อความนับถอยหลัง
         ("In 17 days" / "2 days ago") — ถอด widget ออกให้แสดงเป็นวันที่ตรง ๆ
         และคงไฮไลต์สีแดงเมื่อเลยกำหนดไว้ด้วย decoration แทน
         (view นี้ใช้ร่วมกันทั้งหน้า Vendor Bills และ Customer Invoices) -->
    <record id="view_invoice_tree_due_date_display" model="ir.ui.view">
        <field name="name">account.invoice.list.due.date.display</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="widget"/>
                <attribute name="decoration-danger">invoice_date_due &lt; context_today().strftime('%Y-%m-%d')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
