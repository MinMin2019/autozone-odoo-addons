<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action สำหรับดึง View มาแสดงเมื่อกดเมนู -->
    <record id="action_vendor_payment_report" model="ir.actions.act_window">
        <field name="name">Payment Reports</field>
        <field name="res_model">vendor.payment.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vendor_payment_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                สร้างรายงานการชำระเงินใบแรกของคุณ!
            </p>
        </field>
    </record>

    <!-- นำเมนูไปต่อท้ายเมนู Vendors ของแอพ Accounting -->
    <menuitem id="menu_vendor_payment_report"
              name="Payment Reports"
              parent="account.menu_finance_payables"
              action="action_vendor_payment_report"
              sequence="20"/>
</odoo>
