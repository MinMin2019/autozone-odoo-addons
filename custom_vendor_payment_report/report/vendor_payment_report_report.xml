<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat ขอบแคบ สเปคเดียวกับ "A4 For Custom Report" ที่ฝั่ง AR ใช้
         (ตัวนั้นสร้างมือใน DB ไม่มี xmlid เลยพก record ของตัวเองมาในโมดูล) -->
    <record id="paperformat_vendor_payment" model="report.paperformat">
        <field name="name">A4 Vendor Payment Report</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <!-- สร้าง Action สำหรับ Report -->
    <record id="action_report_vendor_payment" model="ir.actions.report">
        <field name="name">รายงานการชำระเงิน</field>
        <field name="model">vendor.payment.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_vendor_payment_report.report_vendor_payment_template</field>
        <field name="report_file">custom_vendor_payment_report.report_vendor_payment_template</field>
        <field name="print_report_name">'Payment Report - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_vendor_payment"/>
        <field name="binding_model_id" ref="model_vendor_payment_report"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
