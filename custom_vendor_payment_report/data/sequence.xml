<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_vendor_payment_report" model="ir.sequence">
            <field name="name">Vendor Payment Report Sequence</field>
            <field name="code">vendor.payment.report</field>

            <!-- Prefix PR + ปี 2 หลัก + เดือน 2 หลัก (รูปแบบเดียวกับ BN ฝั่งลูกค้า) -->
            <field name="prefix">PR%(y)s%(month)s</field>

            <!-- รันเลข 3 หลัก รีเซ็ตทุกเดือน -->
            <field name="padding">3</field>

            <field name="company_id" eval="False"/>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
