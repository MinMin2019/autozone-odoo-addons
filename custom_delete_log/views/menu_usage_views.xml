<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Menu Usage Log (daily summary) ===== -->
    <record id="view_menu_usage_log_list" model="ir.ui.view">
        <field name="name">menu.usage.log.list</field>
        <field name="model">menu.usage.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" default_order="date desc, visit_count desc">
                <field name="date"/>
                <field name="user_id"/>
                <field name="menu_path"/>
                <field name="menu_id" optional="hide"/>
                <field name="action_name" optional="hide"/>
                <field name="visit_count" sum="Total Visits"/>
            </list>
        </field>
    </record>

    <record id="view_menu_usage_log_pivot" model="ir.ui.view">
        <field name="name">menu.usage.log.pivot</field>
        <field name="model">menu.usage.log</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="menu_path" type="row"/>
                <field name="user_id" type="col"/>
                <field name="visit_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_menu_usage_log_graph" model="ir.ui.view">
        <field name="name">menu.usage.log.graph</field>
        <field name="model">menu.usage.log</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="menu_path"/>
                <field name="visit_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_menu_usage_log_search" model="ir.ui.view">
        <field name="name">menu.usage.log.search</field>
        <field name="model">menu.usage.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="menu_path"/>
                <field name="user_id"/>
                <field name="action_name"/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Last 7 Days" name="last_week"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last 30 Days" name="last_month"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Menu" name="group_menu" context="{'group_by': 'menu_path'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_usage_log" model="ir.actions.act_window">
        <field name="name">Menu Usage</field>
        <field name="res_model">menu.usage.log</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_last_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">ยังไม่มีข้อมูลการเข้าใช้เมนู — ระบบสรุปเป็นรายวันต่อผู้ใช้ต่อเมนู</p>
        </field>
    </record>

    <menuitem id="menu_menu_usage_log" name="Menu Usage"
              parent="menu_delete_log_root" action="action_menu_usage_log" sequence="17"/>

</odoo>
