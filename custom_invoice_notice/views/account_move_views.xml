<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_invoice_notice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.invoice.notice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- ปุ่มพิมพ์ใบแจ้งหนี้ เฉพาะใบขายที่ Confirm แล้ว -->
            <xpath expr="//header" position="inside">
                <button name="action_print_invoice_notice" type="object"
                        string="พิมพ์ใบแจ้งหนี้"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>
            <!-- แท็บ Other Info: ตัวเลือกของใบแจ้งหนี้ -->
            <xpath expr="//page[@id='other_tab']" position="inside">
                <group string="ใบแจ้งหนี้ (Invoice Notice)" name="az_invoice_notice"
                       invisible="move_type != 'out_invoice'">
                    <group>
                        <field name="az_notice_promise_date"/>
                        <field name="az_notice_bank_id"/>
                        <field name="az_notice_hide_wht"/>
                    </group>
                    <group>
                        <field name="az_notice_service_base"/>
                        <field name="az_notice_wht_amount"/>
                        <field name="az_notice_net_amount"/>
                        <field name="az_notice_vat_deferred"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
