<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- กรองผ่าน payslip_ids ไม่ใช่สมุดรายวัน — ใบที่บัญชีลงมือเองในสมุดเดียวกันจะไม่ปนมา -->
    <record id="view_account_move_filter_payroll" model="ir.ui.view">
        <field name="name">account.move.select.payroll</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='misc_filter']" position="after">
                <separator/>
                <filter string="JE เงินเดือน" name="payroll_je" domain="[('payslip_ids', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- Journal Entries ปกติเปิดมาพร้อมตัวกรอง Posted ซึ่งซ่อนดราฟ — เมนูนี้เปิดที่ดราฟเงินเดือนเลย -->
    <record id="action_payroll_journal_entries" model="ir.actions.act_window">
        <field name="name">JE เงินเดือน</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="context">{'default_move_type': 'entry', 'search_default_payroll_je': 1, 'search_default_unposted': 1, 'view_no_maturity': True}</field>
    </record>

    <menuitem id="menu_payroll_journal_entries"
              action="action_payroll_journal_entries"
              parent="account.menu_finance_entries"
              groups="account.group_account_readonly"
              sequence="2"/>
</odoo>
