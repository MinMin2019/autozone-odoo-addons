<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_title_th" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.title.th</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1/field[@name='name']" position="before">
                <field name="title_th" placeholder="คำนำหน้า" class="me-2"
                       style="max-width: 9rem; font-size: min(3vw, 1.8rem);"/>
            </xpath>
            <!-- 3.4.1: ไม่โชว์ job_level บนพนักงานแล้ว — ใช้ "Job Level" บนตำแหน่งงาน (hr.job) ของ
                 autozone_org_chart ที่เดียว; ข้อมูลเดิมยังเก็บในฐาน (ฟิลด์ไม่ถูกลบ) จนกว่า HR ตรวจรายการที่ไม่ตรงเสร็จ -->
        </field>
    </record>
</odoo>
