<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate=1: อัปเกรดโมดูลแล้วไม่ทับค่าที่ผู้ใช้แก้ในระบบ -->
    <data noupdate="1">

        <!-- ===== รายได้ (Earnings) ===== -->
        <record id="input_type_basic" model="hr.payslip.input.type">
            <field name="name">เงินเดือน (Basic Salary)</field>
            <field name="code">BASIC</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_ot" model="hr.payslip.input.type">
            <field name="name">ค่าล่วงเวลา (Overtime)</field>
            <field name="code">OT</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_bonus" model="hr.payslip.input.type">
            <field name="name">โบนัส (Bonus)</field>
            <field name="code">BONUS</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_commission" model="hr.payslip.input.type">
            <field name="name">ค่าคอมมิชชั่น (Commission)</field>
            <field name="code">COMMISSION</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_diligence" model="hr.payslip.input.type">
            <field name="name">เบี้ยขยัน (Diligence Allowance)</field>
            <field name="code">DILIGENCE</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_allowance" model="hr.payslip.input.type">
            <field name="name">เบี้ยเลี้ยง/ค่าตำแหน่ง (Allowance)</field>
            <field name="code">ALLOWANCE</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_inc_other" model="hr.payslip.input.type">
            <field name="name">รายได้อื่น ๆ (Other Income)</field>
            <field name="code">INC_OTHER</field>
            <field name="country_id" eval="False"/>
        </record>

        <!-- ===== รายการหัก (Deductions) — กรอกค่าบวกเสมอ Rule จะติดลบให้เอง ===== -->
        <record id="input_type_sso" model="hr.payslip.input.type">
            <field name="name">ประกันสังคม (Social Security)</field>
            <field name="code">SSO</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_tax" model="hr.payslip.input.type">
            <field name="name">ภาษีเงินได้หัก ณ ที่จ่าย (Withholding Tax)</field>
            <field name="code">TAX</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_pvd" model="hr.payslip.input.type">
            <field name="name">กองทุนสำรองเลี้ยงชีพ (Provident Fund)</field>
            <field name="code">PVD</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_late" model="hr.payslip.input.type">
            <field name="name">มาสาย/ขาดงาน (Late/Absence)</field>
            <field name="code">LATE</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_advance" model="hr.payslip.input.type">
            <field name="name">เงินเบิกล่วงหน้า (Salary Advance)</field>
            <field name="code">ADVANCE</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_loan" model="hr.payslip.input.type">
            <field name="name">เงินกู้สวัสดิการ (Loan Repayment)</field>
            <field name="code">LOAN</field>
            <field name="country_id" eval="False"/>
        </record>
        <record id="input_type_ded_other" model="hr.payslip.input.type">
            <field name="name">รายการหักอื่น ๆ (Other Deduction)</field>
            <field name="code">DED_OTHER</field>
            <field name="country_id" eval="False"/>
        </record>

    </data>
</odoo>
