<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- priority สูงกว่า Odoo Studio (160) เพื่อให้ทับการปลดล็อกช่องเลข PO ที่ทำไว้ใน Studio -->
    <record id="purchase_order_form_az_name_edit" model="ir.ui.view">
        <field name="name">purchase.order.form.az.name.edit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div/h1/field[@name='name']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent')</attribute>
                <attribute name="force_save">0</attribute>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='partner_ref']" position="after">
                <field name="az_name_free_format" readonly="state not in ('draft', 'sent')"
                       invisible="not az_name_free_format and state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
