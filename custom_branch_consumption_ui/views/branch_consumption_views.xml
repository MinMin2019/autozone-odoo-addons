<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_az_branch_consumption_form" model="ir.ui.view">
        <field name="name">az.branch.consumption.form</field>
        <field name="model">az.branch.consumption</field>
        <field name="arch" type="xml">
            <form string="ใบเบิกใช้วัสดุ">
                <header>
                    <button name="action_consume" string="บันทึกเบิก" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="ตัดสต็อกและลงบัญชีค่าใช้จ่ายของสาขาทันที ยืนยัน?"
                            help="สร้างใบเบิกใช้วัสดุ (CONS) ของสาขาและตัดสต็อกให้เลย"/>
                    <button name="action_return" string="เบิกคืน" type="object"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state not in ('draft', 'confirmed')"
                            confirm="ยกเลิกใบเบิกนี้?"/>
                    <button name="action_draft" string="กลับเป็นร่าง" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button"
                                icon="fa-exchange" invisible="picking_count == 0">
                            <field name="picking_count" widget="statinfo" string="ใบเบิก/ใบคืน"/>
                        </button>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not has_shortage">
                        มีรายการที่เบิกเกินของคงเหลือที่สาขา (ตัวเลขสีแดง) — ลดจำนวนหรือรับของเข้าคลังก่อน จึงจะบันทึกเบิกได้
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="allowed_warehouse_ids" invisible="1"/>
                            <field name="warehouse_id" options="{'no_open': True, 'no_create': True}"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="requester" readonly="state != 'draft'"/>
                            <field name="purpose" readonly="state != 'draft'"
                                   placeholder="เช่น ซ่อมรถ กข-1234 / ทำความสะอาดร้าน"/>
                        </group>
                        <group>
                            <field name="user_id" options="{'no_open': True}"/>
                            <field name="picking_id" invisible="not picking_id"/>
                            <field name="location_id" invisible="1"/>
                            <field name="picking_type_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="has_shortage" invisible="1"/>
                            <field name="can_edit" invisible="1"/>
                            <field name="cancelled" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายการสินค้า" name="lines">
                            <!-- context: ให้หน้าต่างเลือกสินค้าโชว์ On Hand ของคลังสาขานี้
                                 + เปิดมาพร้อมตัวกรอง "มีของคงเหลือ" (custom_branch_consumption) -->
                            <field name="line_ids" readonly="state != 'draft'"
                                   context="{'location': location_id, 'search_default_filter_available_here': 1}">
                                <list editable="bottom" decoration-danger="shortage">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" options="{'no_create': True, 'no_open': True}"
                                           context="{'location': parent.location_id, 'search_default_filter_available_here': 1}"/>
                                    <field name="qty_available" string="คงเหลือที่สาขา"
                                           column_invisible="parent.state not in ('draft', 'confirmed')"/>
                                    <field name="product_uom_qty" string="จำนวนเบิก"/>
                                    <field name="product_uom_id"/>
                                    <field name="qty_done" string="เบิกแล้ว (สุทธิ)"
                                           column_invisible="parent.state != 'done'"/>
                                    <field name="shortage" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="qty_total"/>
                            </group>
                        </page>
                        <page string="หมายเหตุ" name="note">
                            <field name="note" placeholder="รายละเอียดเพิ่มเติม (จะติดไปที่ใบ CONS ด้วย)"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_az_branch_consumption_list" model="ir.ui.view">
        <field name="name">az.branch.consumption.list</field>
        <field name="model">az.branch.consumption</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'confirmed'" decoration-muted="state == 'cancel'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="requester" optional="show"/>
                <field name="purpose" optional="show"/>
                <field name="qty_total" sum="รวม"/>
                <field name="picking_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_az_branch_consumption_search" model="ir.ui.view">
        <field name="name">az.branch.consumption.search</field>
        <field name="model">az.branch.consumption</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="requester"/>
                <field name="purpose"/>
                <field name="line_ids" string="สินค้า"
                       filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="draft" string="ร่าง" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="เบิกแล้ว" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="today" string="วันนี้"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_month" string="เดือนนี้"
                        domain="[('date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_wh" string="สาขา" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="เดือน" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_az_branch_consumption" model="ir.actions.act_window">
        <field name="name">เบิกใช้วัสดุ</field>
        <field name="res_model">az.branch.consumption</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_az_branch_consumption_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">สร้างใบเบิกใช้วัสดุ</p>
            <p>เลือกสาขา ใส่สินค้าและจำนวน แล้วกด "บันทึกเบิก"
               ระบบจะตัดสต็อกและลงบัญชีค่าใช้จ่ายของสาขาให้ทันที</p>
        </field>
    </record>

    <!-- ทางลัด: เปิดฟอร์มใบเบิกใหม่ทันที (คลิกเดียวจากเมนู) -->
    <record id="action_az_branch_consumption_new" model="ir.actions.act_window">
        <field name="name">เบิกใช้วัสดุ (ใบใหม่)</field>
        <field name="res_model">az.branch.consumption</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_az_branch_consumption_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_az_branch_consumption" name="เบิกใช้วัสดุ"
              parent="stock.menu_stock_warehouse_mgmt" action="action_az_branch_consumption"
              sequence="17" groups="stock.group_stock_user"/>
    <menuitem id="menu_az_branch_consumption_new" name="+ เบิกใช้วัสดุ ใบใหม่"
              parent="stock.menu_stock_warehouse_mgmt" action="action_az_branch_consumption_new"
              sequence="18" groups="stock.group_stock_user"/>

</odoo>
