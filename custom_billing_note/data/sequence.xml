<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_customer_billing_note" model="ir.sequence">
            <field name="name">Customer Billing Note Sequence</field>
            <field name="code">customer.billing.note</field>
            
            <!-- เปลี่ยน Prefix เป็น BN + ปี 2 หลัก (y) + เดือน 2 หลัก (M) -->
            <field name="prefix">BN%(y)s%(month)s</field>
            
            <!-- รันเลข 3 หลัก -->
            <field name="padding">3</field>
            
            <field name="company_id" eval="False"/>
            
            <!-- (ออปชันเสริม) ถ้าอยากให้เลขรีเซ็ตกลับเป็น 001 ใหม่ทุกๆ เดือน ให้เพิ่มบรรทัดนี้ครับ -->
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
