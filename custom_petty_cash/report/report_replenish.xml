<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_replenish_structure">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-call="custom_petty_cash.pc_style" />
                    <t t-set="company" t-value="o.company_id" />
                    <div class="page">
                        <div class="pc-body">
                        <t t-call="custom_petty_cash.pc_company_header" />

                        <div style="text-align: center; margin-top: 55px; margin-bottom: 10px;">
                            <div class="text-bold" style="font-size: 28px; letter-spacing: 1px;">
                                ใบสรุปขอเติมเงินสดย่อย <span class="text-bold" style="font-size: 22px;">/ PETTY CASH REPLENISHMENT</span>
                            </div>
                        </div>

                        <div style="margin-top: 40px;">
                            <table class="layout-table">
                                <tr>
                                    <td style="width: 62%; padding-right: 20px;">
                                        <div style="margin-bottom: 10px;">
                                            <span class="text-bold">กองเงินสดย่อย / สาขา :</span>
                                            <span t-esc="o.fund_id.display_name" />
                                        </div>
                                        <div style="margin-bottom: 10px;">
                                            <span class="text-bold">วงเงิน :</span>
                                            <span t-esc="'{:,.2f}'.format(o.fund_id.amount_limit)" /> บาท
                                        </div>
                                        <div style="margin-bottom: 10px;" t-if="o.transfer_ref">
                                            <span class="text-bold">อ้างอิงรายการโอน/JE :</span>
                                            <span t-esc="o.transfer_ref" />
                                        </div>
                                    </td>
                                    <td style="width: 38%; padding-left: 20px;">
                                        <table class="layout-table">
                                            <tr>
                                                <td style="width: 45%; padding-bottom: 5px; white-space: nowrap;">เลขที่เอกสาร / No. :</td>
                                                <td style="width: 55%; padding-bottom: 5px;">
                                                    <div class="text-bold" style="font-size: 19px;">
                                                        <span t-esc="o.name" />
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom: 5px; white-space: nowrap;">วันที่ / Date :</td>
                                                <td style="padding-bottom: 5px;">
                                                    <span t-esc="o.date and o.date.strftime('%d/%m/%Y') or ''" />
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div style="margin-top: 25px;">
                            <div class="text-bold" style="margin-bottom: 8px;">ใบเคลียร์ที่รวมเติมเงิน</div>
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 20%;">เลขที่</th>
                                        <th style="width: 15%;">วันที่</th>
                                        <th style="width: 45%;">อ้างถึงใบเบิก</th>
                                        <th style="width: 20%;">ยอดใช้จ่าย</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.clearing_ids" t-as="clr">
                                        <td><span t-esc="clr.name" /></td>
                                        <td style="text-align: center;">
                                            <span t-esc="clr.date and clr.date.strftime('%d/%m/%Y') or ''" />
                                        </td>
                                        <td style="font-size: 15px;">
                                            <span t-esc="', '.join(clr.request_ids.mapped('name'))" />
                                        </td>
                                        <td class="num">
                                            <span t-esc="'{:,.2f}'.format(clr.amount_spent)" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-top: 25px;">
                            <div class="text-bold" style="margin-bottom: 8px;">
                                สรุปตามหมวดบัญชี (สำหรับฝ่ายบัญชีลงรายการเติมเงิน)</div>
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th style="width: 12%;">รหัสบัญชี</th>
                                        <th style="width: 43%;">ชื่อบัญชี</th>
                                        <th style="width: 15%;">ก่อน VAT</th>
                                        <th style="width: 15%;">VAT (ภาษีซื้อ)</th>
                                        <th style="width: 15%;">รวม</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="summary" t-value="o.get_expense_summary()" />
                                    <tr t-foreach="summary" t-as="row">
                                        <td style="text-align: center;">
                                            <span t-esc="row['account'].code" />
                                        </td>
                                        <td><span t-esc="row['account'].name" /></td>
                                        <td class="num">
                                            <span t-esc="'{:,.2f}'.format(row['untaxed'])" />
                                        </td>
                                        <td class="num">
                                            <span t-if="row['tax']" t-esc="'{:,.2f}'.format(row['tax'])" />
                                        </td>
                                        <td class="num">
                                            <span t-esc="'{:,.2f}'.format(row['total'])" />
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color: #f9f9f9; font-weight: bold;">
                                        <td colspan="2" style="padding-left: 10px; font-style: italic;">
                                            <span t-esc="o.currency_id.with_context(lang='th_TH').amount_to_text(o.amount_total)" />
                                        </td>
                                        <td class="num">
                                            <span t-esc="'{:,.2f}'.format(sum(r['untaxed'] for r in summary))" />
                                        </td>
                                        <td class="num">
                                            <span t-esc="'{:,.2f}'.format(sum(r['tax'] for r in summary))" />
                                        </td>
                                        <td class="num">
                                            <span t-esc="'{:,.2f}'.format(o.amount_total)" />
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        </div>

                        <t t-set="sign_boxes"
                            t-value="[('ผู้จัดทำ', 'Prepared By', False), ('ผู้ตรวจสอบ', 'Inspector', False), ('ผู้อนุมัติ', 'Approved By', False)]" />
                        <t t-call="custom_petty_cash.pc_sign_boxes" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
