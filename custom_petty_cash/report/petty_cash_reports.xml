<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- paperformat ของโมดูลเอง (ห้ามอ้างของโมดูลอื่น/ใน DB — บทเรียนจาก custom_vendor_payment_report) -->
        <record id="paperformat_petty_cash" model="report.paperformat">
            <field name="name">Petty Cash A4</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
            <field name="disable_shrinking" eval="False" />
        </record>

        <record id="action_report_petty_cash_request" model="ir.actions.report">
            <field name="name">ใบเบิกเงินสดย่อย</field>
            <field name="model">petty.cash.request</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_request_structure</field>
            <field name="paperformat_id" ref="paperformat_petty_cash" />
            <field name="binding_model_id" ref="model_petty_cash_request" />
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_petty_cash_clearing" model="ir.actions.report">
            <field name="name">ใบสำคัญจ่ายเงินสดย่อย</field>
            <field name="model">petty.cash.clearing</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_clearing_structure</field>
            <field name="paperformat_id" ref="paperformat_petty_cash" />
            <field name="binding_model_id" ref="model_petty_cash_clearing" />
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_petty_cash_replenish" model="ir.actions.report">
            <field name="name">ใบสรุปขอเติมเงินสดย่อย</field>
            <field name="model">petty.cash.replenish</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_replenish_structure</field>
            <field name="paperformat_id" ref="paperformat_petty_cash" />
            <field name="binding_model_id" ref="model_petty_cash_replenish" />
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_petty_cash_count" model="ir.actions.report">
            <field name="name">ใบนับเงินสดย่อย</field>
            <field name="model">petty.cash.count</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_petty_cash.report_count_structure</field>
            <field name="paperformat_id" ref="paperformat_petty_cash" />
            <field name="binding_model_id" ref="model_petty_cash_count" />
            <field name="binding_type">report</field>
        </record>

        <!-- ============ ส่วนกลางที่ทุกฟอร์มใช้ร่วมกัน ============ -->

        <!-- CSS ชุดเดียวกับใบสำคัญไทย (thai_accounting_vouchers) แบบย่อ:
             ไม่มีระบบแบ่งหน้าเป็นบล็อก แต่เอกสารยาวเกินหนึ่งหน้าได้ —
             ช่องลายเซ็นอยู่ใน flow และห้ามโดนหั่นข้ามหน้า (ดู .signature-footer) -->
        <template id="pc_style">
            <style>
                * { box-sizing: border-box !important; }
                html, body, #wrapwrap, main, .article {
                margin: 0 !important;
                padding: 0 !important;
                min-height: 0 !important;
                max-width: none !important;
                border: 0 !important;
                }
                .page {
                font-family: Sarabun, sans-serif;
                font-size: 18px;
                color: #000;
                width: 1400px;
                min-height: 1920px;
                }
                /* เนื้อหาก่อนช่องลายเซ็น: เอกสารสั้นให้ดันลายเซ็นลงไปท้ายหน้าแรก
                   (1700 = 1920 - ความสูงช่องลายเซ็น - ระยะห่าง) */
                .pc-body {
                min-height: 1700px;
                }
                table.layout-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #ffffff !important;
                background-color: transparent;
                }
                table.layout-table td, table.layout-table th, table.layout-table tr {
                vertical-align: top;
                padding: 0;
                border: 1px solid #ffffff !important;
                background-color: transparent;
                }
                table.data-table {
                width: 100%;
                border-collapse: collapse;
                }
                table.data-table th, table.data-table td {
                border: 1px solid #000 !important;
                padding: 6px 8px;
                vertical-align: top;
                }
                table.data-table th {
                background-color: #eee;
                text-align: center;
                }
                .num { text-align: right; }
                /* อยู่ใน flow ปกติ + ห้ามหั่นข้ามหน้า: ถ้าท้ายหน้าเหลือที่ไม่พอ
                   ให้ยกทั้งบล็อกไปขึ้นหน้าใหม่ (เดิมใช้ position absolute แล้วโดน
                   wkhtmltopdf ตัดกลางตารางเมื่อเอกสารยาวเกินหนึ่งหน้า) */
                .signature-footer {
                width: 100%;
                margin-top: 30px;
                page-break-inside: avoid;
                }
                .signature-footer table {
                page-break-inside: avoid;
                }
            </style>
        </template>

        <!-- หัวกระดาษ: โลโก้ + บริษัท (คาดหวังตัวแปร company) -->
        <template id="pc_company_header">
            <table class="layout-table" style="margin-bottom: 15px;">
                <tr>
                    <td style="width: 1%; white-space: nowrap; padding-right: 15px; vertical-align: middle;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                            style="max-height: 55px; width: auto;" alt="Logo" />
                    </td>
                    <td style="vertical-align: middle;">
                        <div class="text-bold" style="font-size: 25px; line-height: 1.2; margin-bottom: 5px;">
                            <span t-esc="company.name" />
                        </div>
                        <div style="font-size: 16px; color: #333; line-height: 1.3;">
                            <span t-esc="company.partner_id.get_thai_address()" />
                            <br />
                            <span t-if="company.phone"> โทร: <span t-esc="company.phone" /></span>
                            <span t-if="company.vat" style="margin-left: 10px;">
                                เลขประจำตัวผู้เสียภาษี: <span t-esc="company.vat" />
                            </span>
                        </div>
                    </td>
                </tr>
            </table>
        </template>

        <!-- ช่องลายเซ็น (คาดหวังตัวแปร sign_boxes = [(ไทย, อังกฤษ, ชื่อที่พิมพ์ไว้ล่วงหน้า|False)]) -->
        <template id="pc_sign_boxes">
            <div class="signature-footer">
                <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
                    <tr>
                        <t t-foreach="sign_boxes" t-as="box">
                            <td t-attf-style="width: {{ '%.0f' % (100.0 / len(sign_boxes)) }}%; vertical-align: top; padding: 8px; height: 155px; {{ 'border-right: 1px solid #000;' if box_index &lt; len(sign_boxes) - 1 else '' }}">
                                <div style="text-align: center; font-weight: bold; font-size: 15px; margin-bottom: 55px;">
                                    <span t-esc="box[0]" /> <br />
                                    <span style="font-size: 12px; font-weight: normal;">(<span t-esc="box[1]" />)</span>
                                </div>
                                <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto;"></div>
                                <div style="text-align: center; font-size: 15px; margin-top: 8px; height: 22px;">
                                    <span t-if="box[2]" t-esc="'( %s )' % box[2]" />
                                </div>
                                <div style="text-align: center; font-size: 18px; margin-top: 4px;">
                                    วันที่ ........./........./..............
                                </div>
                            </td>
                        </t>
                    </tr>
                </table>
            </div>
        </template>
    </data>
</odoo>
