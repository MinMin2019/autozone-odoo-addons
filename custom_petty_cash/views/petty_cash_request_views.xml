<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_request_list" model="ir.ui.view">
        <field name="name">petty.cash.request.list</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <list default_order="date desc, name desc">
                <field name="name" />
                <field name="date" />
                <field name="fund_id" />
                <field name="requester_name" />
                <field name="purpose" optional="show" />
                <field name="amount" sum="รวม" />
                <field name="clearing_id" optional="show" />
                <field name="state" widget="badge"
                    decoration-info="state == 'paid'"
                    decoration-success="state == 'cleared'"
                    decoration-muted="state == 'cancel'" />
                <field name="currency_id" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="view_petty_cash_request_form" model="ir.ui.view">
        <field name="name">petty.cash.request.form</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="ยืนยัน (จ่ายเงินแล้ว)" type="object"
                        class="btn-primary" invisible="state != 'draft'" />
                    <button name="action_cancel" string="ยกเลิก" type="object"
                        invisible="state not in ('draft', 'paid')" />
                    <button name="action_reset_draft" string="กลับเป็นร่าง" type="object"
                        invisible="state != 'cancel'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,paid,cleared" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="name_editable" invisible="1" />
                        <h1><field name="name" readonly="not name_editable"
                            placeholder="ระบบออกเลขให้เมื่อบันทึก" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fund_id" readonly="state != 'draft'" />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="requester_name" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'" />
                            <field name="purpose" readonly="state != 'draft'" />
                            <field name="clearing_id" />
                            <field name="currency_id" invisible="1" />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="หมายเหตุ..." />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_petty_cash_request_search" model="ir.ui.view">
        <field name="name">petty.cash.request.search</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="requester_name" />
                <field name="purpose" />
                <field name="fund_id" />
                <filter name="filter_open" string="ค้างเคลียร์"
                    domain="[('state', '=', 'paid')]" />
                <filter name="filter_draft" string="ร่าง" domain="[('state', '=', 'draft')]" />
                <group expand="0" string="Group By">
                    <filter name="group_fund" string="กองเงินสดย่อย"
                        context="{'group_by': 'fund_id'}" />
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_request" model="ir.actions.act_window">
        <field name="name">ใบเบิกเงินสดย่อย</field>
        <field name="res_model">petty.cash.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
