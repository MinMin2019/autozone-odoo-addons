<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- สิทธิ์แก้เลขที่เอกสารเงินสดย่อย — แยกเป็นกลุ่มของตัวเอง ไม่ผูกกับสิทธิ์
             บัญชีมาตรฐาน เพราะธุรการสาขาก็ถือ account.group_account_* เกือบครบ
             ถ้าอิงกลุ่มพวกนั้นจะกลายเป็นเปิดให้ทุกคนแก้ = ไม่ได้คุมอะไร
             ค่าเริ่มต้นให้เฉพาะ admin — ฝ่ายบัญชีคนไหนควรได้ ให้เพิ่มเองที่
             Settings > Users > แท็บสิทธิ์ > Other -->
        <record id="group_petty_cash_number_admin" model="res.groups">
            <field name="name">แก้เลขที่เอกสารเงินสดย่อย</field>
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
            <field name="comment">แก้เลขที่ใบเบิก/ใบเคลียร์/ใบขอเติมเงิน/ใบนับเงิน ได้เฉพาะตอนเอกสารยังเป็นร่าง (เลขห้ามซ้ำกับเอกสารเดิม)</field>
        </record>
    </data>
</odoo>
