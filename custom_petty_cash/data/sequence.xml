<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_petty_cash_request" model="ir.sequence">
            <field name="name">ใบเบิกเงินสดย่อย</field>
            <field name="code">petty.cash.request</field>
            <field name="prefix">PCR%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
        </record>
        <record id="seq_petty_cash_clearing" model="ir.sequence">
            <field name="name">ใบเคลียร์เงินสดย่อย</field>
            <field name="code">petty.cash.clearing</field>
            <field name="prefix">PCC%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
        </record>
        <record id="seq_petty_cash_count" model="ir.sequence">
            <field name="name">ใบนับเงินสดย่อย</field>
            <field name="code">petty.cash.count</field>
            <field name="prefix">PCN%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
        </record>
        <record id="seq_petty_cash_replenish" model="ir.sequence">
            <field name="name">ใบขอเติมเงินสดย่อย</field>
            <field name="code">petty.cash.replenish</field>
            <field name="prefix">PCP%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range">True</field>
        </record>
    </data>
</odoo>
