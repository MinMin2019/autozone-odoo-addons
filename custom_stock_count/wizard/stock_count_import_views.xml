<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_az_stock_count_import_form" model="ir.ui.view">
        <field name="name">az.stock.count.import.form</field>
        <field name="model">az.stock.count.import</field>
        <field name="arch" type="xml">
            <form string="นำเข้ายอดนับจาก Excel">
                <p class="text-muted">
                    ใช้ไฟล์ที่กด <b>Export Excel</b> จากใบนับนี้ แล้วกรอกคอลัมน์ <b>ยอดตรวจนับ (F)</b>
                    และ <b>หมายเหตุ (H)</b> — แถวที่ยอดตรวจนับว่างจะถูกข้าม (ถือว่ายังไม่นับ)
                </p>
                <group>
                    <field name="count_id" readonly="1"/>
                    <field name="file" filename="filename" invisible="result"/>
                    <field name="filename" invisible="1"/>
                    <field name="overwrite" invisible="result"/>
                    <field name="result" invisible="not result" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import" string="นำเข้า" type="object" class="btn-primary"
                            invisible="result"/>
                    <button string="ปิด" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
