<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_lead_view_form_contract_kpi" model="ir.ui.view">
        <field name="name">crm.lead.form.contract.kpi</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_contract_quotations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    invisible="contract_quotation_count == 0"
                >
                    <field
                        name="contract_quotation_count"
                        widget="statinfo"
                        string="ใบเสนอราคาสัญญา / Contract Quotes"
                    />
                </button>
                <button
                    name="action_view_blanket_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-book"
                    invisible="blanket_order_count == 0"
                >
                    <field
                        name="blanket_order_count"
                        widget="statinfo"
                        string="สัญญาแม่ / Blanket Orders"
                    />
                </button>
                <button
                    name="action_view_releases"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="release_count == 0"
                >
                    <field
                        name="release_count"
                        widget="statinfo"
                        string="ใบเรียก / Releases"
                    />
                </button>
                <button
                    name="action_view_contract_invoices"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    invisible="contract_invoice_count == 0"
                >
                    <field
                        name="contract_invoice_count"
                        widget="statinfo"
                        string="ใบวางบิล / Invoices"
                    />
                </button>
                <button
                    name="action_view_contract_timeline"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-line-chart"
                    string="Timeline ตามเวลา"
                    invisible="blanket_order_count == 0"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="KPI สัญญา / Contract KPI" name="contract_kpi">
                    <group>
                        <group string="โปรเจกต์ / Project">
                            <field name="analytic_account_id" />
                        </group>
                    </group>
                    <group>
                        <group string="จำนวน / Quantities" name="kpi_qty">
                            <field name="quoted_qty" />
                            <field name="contract_qty" />
                            <field name="released_qty" />
                            <field name="invoiced_qty" />
                            <field name="to_invoice_qty" />
                            <field name="remaining_to_bo_qty" />
                            <field name="remaining_release_qty" />
                        </group>
                        <group string="มูลค่า / Amounts" name="kpi_amount">
                            <field name="quoted_amount" />
                            <field name="released_amount" />
                            <field name="invoiced_amount" />
                            <field name="to_invoice_amount" />
                            <field name="company_currency" invisible="1" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
