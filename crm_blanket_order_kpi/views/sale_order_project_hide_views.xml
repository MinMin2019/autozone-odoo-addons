<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
      Bridge with sale_project: the standard "Project" (project.project) field is
      not used by this contract flow (we track the project via the analytic
      account on the Opportunity instead). Hide it on contract-source quotations
      to avoid confusing two "project" concepts.
      Remove this file + the sale_project dependency if not wanted.
    -->
    <record id="view_order_form_hide_project_contract_source" model="ir.ui.view">
        <field name="name">sale.order.form.hide.project.contract.source</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="invisible">is_contract_source</attribute>
            </xpath>
        </field>
    </record>
</odoo>
