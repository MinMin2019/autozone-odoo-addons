<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_blanket_order_create_wizard_form" model="ir.ui.view">
        <field name="name">crm.blanket.order.create.wizard.form</field>
        <field name="model">crm.blanket.order.create.wizard</field>
        <field name="arch" type="xml">
            <form string="สร้างสัญญาแม่ / Create Blanket Order">
                <group>
                    <field name="quotation_id" />
                    <field name="opportunity_id" />
                    <field name="validity_date" />
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="order_line_id" force_save="1" column_invisible="True" />
                        <field name="product_id" readonly="1" />
                        <field name="product_uom" readonly="1" />
                        <field name="quoted_qty" readonly="1" />
                        <field name="qty" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create_blanket_order"
                        type="object"
                        string="สร้างสัญญาแม่ / Create Blanket Order"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
