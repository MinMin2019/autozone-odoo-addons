<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_contract_status" model="ir.actions.report">
        <field name="name">สถานะสัญญา / Contract Status</field>
        <field name="model">crm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">crm_blanket_order_kpi.report_contract_status</field>
        <field name="report_file">crm_blanket_order_kpi.report_contract_status</field>
        <field name="binding_model_id" ref="crm.model_crm_lead" />
        <field name="binding_type">report</field>
        <field name="print_report_name">'Contract Status - %s' % (object.name)</field>
    </record>

    <template id="report_contract_status">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="cur" t-value="doc.company_currency" />
                    <div class="page">
                        <h2 class="mb-1">สถานะสัญญา / Contract Status</h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Opportunity:</strong>
                                <span t-field="doc.name" />
                                <br />
                                <strong>ลูกค้า / Customer:</strong>
                                <span t-field="doc.partner_id" />
                                <br />
                                <strong>โปรเจกต์ / Project:</strong>
                                <span t-field="doc.analytic_account_id" />
                            </div>
                            <div class="col-6">
                                <strong>พนักงานขาย / Salesperson:</strong>
                                <span t-field="doc.user_id" />
                                <br />
                                <strong>คาดปิด / Expected Closing:</strong>
                                <span t-field="doc.date_deadline" />
                            </div>
                        </div>

                        <h4>สรุป KPI / Summary</h4>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>รายการ / Item</th>
                                    <th class="text-end">จำนวน / Qty</th>
                                    <th class="text-end">มูลค่า / Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>ยอดเสนอ / Quoted</td>
                                    <td class="text-end"><span t-field="doc.quoted_qty" /></td>
                                    <td class="text-end"><span t-field="doc.quoted_amount" t-options="{'widget': 'monetary', 'display_currency': cur}" /></td>
                                </tr>
                                <tr>
                                    <td>ยอดสัญญา / Contract</td>
                                    <td class="text-end"><span t-field="doc.contract_qty" /></td>
                                    <td class="text-end">-</td>
                                </tr>
                                <tr>
                                    <td>ยอดเรียกแล้ว / Released</td>
                                    <td class="text-end"><span t-field="doc.released_qty" /></td>
                                    <td class="text-end"><span t-field="doc.released_amount" t-options="{'widget': 'monetary', 'display_currency': cur}" /></td>
                                </tr>
                                <tr>
                                    <td>ยอดวางบิล / Invoiced</td>
                                    <td class="text-end"><span t-field="doc.invoiced_qty" /></td>
                                    <td class="text-end"><span t-field="doc.invoiced_amount" t-options="{'widget': 'monetary', 'display_currency': cur}" /></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>ยอดค้างวางบิล / To Invoice</td>
                                    <td class="text-end"><span t-field="doc.to_invoice_qty" /></td>
                                    <td class="text-end"><span t-field="doc.to_invoice_amount" t-options="{'widget': 'monetary', 'display_currency': cur}" /></td>
                                </tr>
                                <tr>
                                    <td>คงเหลือรอแตก BO / Remaining to BO</td>
                                    <td class="text-end"><span t-field="doc.remaining_to_bo_qty" /></td>
                                    <td class="text-end">-</td>
                                </tr>
                                <tr>
                                    <td>คงเหลือรอเรียก / Remaining to Release</td>
                                    <td class="text-end"><span t-field="doc.remaining_release_qty" /></td>
                                    <td class="text-end">-</td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-4">แยกตามสินค้า / By Product</h4>
                        <t t-set="lines" t-value="doc._get_contract_bo_lines()" />
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>สินค้า / Product</th>
                                    <th class="text-end">สัญญา / Contract</th>
                                    <th class="text-end">เรียกแล้ว / Released</th>
                                    <th class="text-end">วางบิล / Invoiced</th>
                                    <th class="text-end">ค้างวางบิล / To Invoice</th>
                                    <th class="text-end">รอเรียก / Remaining</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <td><span t-field="line.product_id" /></td>
                                    <td class="text-end"><span t-field="line.original_uom_qty" /></td>
                                    <td class="text-end"><span t-field="line.ordered_uom_qty" /></td>
                                    <td class="text-end"><span t-field="line.invoiced_qty_posted" /></td>
                                    <td class="text-end"><span t-field="line.to_invoice_qty" /></td>
                                    <td class="text-end"><span t-field="line.remaining_uom_qty" /></td>
                                </tr>
                                <tr t-if="not lines">
                                    <td colspan="6" class="text-center text-muted">ยังไม่มีสัญญา (Blanket Order) / No confirmed Blanket Order yet</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
