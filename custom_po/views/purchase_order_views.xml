<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- เพิ่มคอลัมน์รูปสินค้าในตาราง order line ของฟอร์ม Purchase Order -->
    <record id="purchase_order_form_product_image" model="ir.ui.view">
        <field name="name">purchase.order.form.product.image</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="product_image" widget="image"
                       options="{'size': [45, 45]}" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
