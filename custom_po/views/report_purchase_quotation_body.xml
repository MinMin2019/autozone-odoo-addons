<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchasequotation_custom_final"
        inherit_id="purchase.report_purchasequotation_document">

        <!-- 1. ลบ Address & Shipping Info Block เดิม (จะสร้างใหม่ใน body) -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" />
        </xpath>
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" />
        </xpath>

        <!-- 2. ลบหัวข้อเดิม "Request for Quotation ..." (จะสร้างใหม่เอง) -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title" />
        </xpath>

        <!-- 3. แทรกส่วนหัวแบบเดียวกับใบ PO ไว้ก่อนตารางข้อมูล -->
        <xpath expr="//table[hasclass('table-borderless')]" position="before">

            <!-- Logo + Company Info (เหมือนใบ PO) -->
            <table class="table table-bordered"
                style="margin-bottom: 15px; border: 1px solid #ffffff;">
                <tr>
                    <!-- Col 1: Logo -->
                    <td
                        style="width: 1%; white-space: nowrap; padding-right: 15px; vertical-align: middle;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                            style="max-height: 55px; width: auto;" alt="Logo" />
                    </td>

                    <!-- Col 2: Company Info -->
                    <td style="vertical-align: middle;">
                        <strong style="font-size: 18px;">
                            <span t-field="o.company_id.name" />
                        </strong>
                        <div style="font-size: 12px; line-height: 1.3;">
                            <span t-out="o.company_id.partner_id.get_thai_address()" />
                            <br />
                            <span>โทร: </span>
                            <span t-field="o.company_id.phone" />
                            <span t-if="o.company_id.vat"> เลขประจำตัวผู้เสียภาษี: <span
                                    t-field="o.company_id.vat" />
                            </span>
                        </div>
                    </td>

                </tr>
            </table>

            <!-- ส่วนหัว "ใบขอราคา" -->
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <h2 class="my-custom-title" style="font-weight: bold; margin-bottom: 5px;">ใบขอราคา
                        / Request for Quotation</h2>
                </div>
            </div>

            <!-- Vendor & Shipping Address (city/state/zip บรรทัดเดียวกัน) -->
            <t t-set="vendor" t-value="o.partner_id" />
            <t t-set="ship" t-value="o.dest_address_id or o.picking_type_id.warehouse_id.partner_id" />
            <div class="row mb-4">
                <div class="col-6" style="padding-right: 20px;">
                    <div
                        style="border-bottom: 1px solid #ddd; margin-bottom: 10px; padding-bottom: 5px;">
                        <strong>Vendor:</strong>
                    </div>
                    <div>
                        <div><strong t-field="vendor.name" /></div>
                        <div><span t-out="vendor.get_thai_address()" /></div>
                        <div t-if="vendor.phone">โทร: <span t-field="vendor.phone" /></div>
                        <div t-if="vendor.vat">VAT: <span t-field="vendor.vat" /></div>
                    </div>
                </div>
                <div class="col-6" style="padding-left: 20px;">
                    <div
                        style="border-bottom: 1px solid #ddd; margin-bottom: 10px; padding-bottom: 5px;">
                        <strong>Shipping Address:</strong>
                    </div>
                    <div t-if="ship">
                        <div><strong t-field="ship.name" /></div>
                        <div><span t-out="ship.get_thai_address()" /></div>
                        <div t-if="ship.phone">โทร: <span t-field="ship.phone" /></div>
                    </div>
                </div>
            </div>

            <!-- ชื่อเอกสาร (ซ้าย) + Expected Arrival (ขวา) เหมือนใบ PO -->
            <div class="row mb-3 align-items-end">
                <div class="col-6 text-left">
                    <h3 style="font-weight: bold;">Request for Quotation #<span t-field="o.name" />
                    </h3>
                </div>
                <div class="col-6" style="text-align: right;">
                    <div t-if="o.date_planned">
                        <strong style="color: #666;">Expected Date:</strong>
                        <br />
                        <span t-field="o.date_planned" t-options='{"widget": "date"}' />
                    </div>
                </div>
            </div>

        </xpath>

        <!-- 4.0 ให้หัวตาราง (thead) ทำซ้ำทุกหน้าเมื่อรายการยาวหลายหน้า -->
        <xpath expr="//table[hasclass('table-borderless')]/thead" position="attributes">
            <attribute name="style">display: table-header-group</attribute>
        </xpath>

        <!-- 4. เพิ่มคอลัมน์ "รูปสินค้า" ต่อจาก Description -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_product_image" class="text-center"><strong>รูปสินค้า</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td class="text-center">
                <img t-if="order_line.product_id.image_128"
                    t-att-src="image_data_uri(order_line.product_id.image_128)"
                    style="max-height: 60px; max-width: 60px; object-fit: contain;"
                    alt="Product" />
            </td>
        </xpath>

        <!-- 5. ลบคอลัมน์ Expected Date ออกจากตาราง (ย้ายไปไว้ด้านบนขวาแทน) -->
        <xpath expr="//th[@name='th_expected_date']" position="replace"/>
        <xpath expr="//td[span[@t-field='order_line.date_planned']]" position="replace"/>

        <!-- 5.1 แยกคอลัมน์ Qty ออกเป็น Qty (ตัวเลข) + Unit (หน่วย) -->
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_uom" class="text-start"><strong>Unit</strong></th>
        </xpath>
        <xpath expr="//td[span[@t-field='order_line.product_qty']]" position="replace">
            <td class="text-end">
                <span t-field="order_line.product_qty" />
                <span t-if="order_line.product_packaging_id">
                    (<span t-field="order_line.product_packaging_qty" t-options='{"widget": "integer"}' /> <span t-field="order_line.product_packaging_id" />)
                </span>
            </td>
            <td class="text-start">
                <span t-field="order_line.product_uom" groups="uom.group_uom" />
            </td>
        </xpath>

        <!-- 5.2 ตัวหนังสือส่วน body เป็นตัวบาง (strong/หัวข้อยังหนาปกติ) -->
        <xpath expr="//div[@class='page']" position="inside">
            <style>
                .page { font-weight: 300; }
            </style>
        </xpath>

        <!-- 6. ลายเซ็นท้ายเอกสาร: Purchasing (ซ้าย) / Vendor (ขวา) -->
        <xpath expr="//table[hasclass('table-borderless')]" position="after">
            <div class="row mb-4 align-items-center justify-content-between"
                style="page-break-inside: avoid; font-size: 13px; padding-left: 50px; padding-right: 50px; margin-top: 100px;">

                <!-- Purchasing -->
                <div class="col-4 text-center">
                    <div style="height: 55px; margin-bottom: 15px;">
                        <img t-if="o.create_uid.purchase_signature"
                            t-att-src="image_data_uri(o.create_uid.purchase_signature)"
                            style="max-height: 55px; max-width: 90%;" alt="Signature" />
                    </div>
                    <div style="border-top: 1px solid #000; margin: 0 auto 5px auto; width: 90%;"></div>
                    <div>
                        <strong>Purchasing</strong>
                    </div>
                </div>

                <!-- Vendor -->
                <div class="col-4 text-center">
                    <div style="height: 55px; margin-bottom: 15px;"></div>
                    <div style="border-top: 1px solid #000; margin: 0 auto 5px auto; width: 90%;"></div>
                    <div>
                        <strong>Vendor</strong>
                    </div>
                </div>

            </div>
        </xpath>

    </template>
</odoo>
