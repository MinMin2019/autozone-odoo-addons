<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The ID card number is the one key the blacklist check trusts, so the
         web form asks for it; applicants who keyed it in are matched exactly
         instead of by name. -->
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>hr.applicant</value>
        <value eval="['identification_id']"/>
    </function>

    <template id="apply_autozone" inherit_id="website_hr_recruitment.apply" name="Autozone: ฟอร์มสมัครงาน">
        <xpath expr="//input[@name='partner_phone']/ancestor::div[hasclass('s_website_form_field')][1]" position="after">
            <div class="col-12 mb-0 py-2 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                <div class="row s_col_no_resize s_col_no_bgcolor">
                    <label class="col-4 col-sm-auto s_website_form_label" style="width: 200px" for="az_identification">
                        <span class="s_website_form_label_content">เลขบัตรประชาชน</span>
                        <span class="s_website_form_mark"> *</span>
                    </label>
                    <div class="col-sm">
                        <input id="az_identification" type="text" inputmode="numeric" maxlength="17"
                               class="form-control s_website_form_input" name="identification_id" required=""
                               placeholder="13 หลัก"/>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//input[@name='job_id']/ancestor::div[hasclass('s_website_form_field')][1]" position="before">
            <div class="col-12 mb-0 py-2 s_website_form_field s_website_form_custom s_website_form_required" data-type="boolean" data-name="Field">
                <div class="row s_col_no_resize s_col_no_bgcolor">
                    <label class="col-4 col-sm-auto s_website_form_label" style="width: 200px" for="az_pdpa">
                        <span class="s_website_form_label_content">ความยินยอม</span>
                        <span class="s_website_form_mark"> *</span>
                    </label>
                    <div class="col-sm">
                        <div class="form-check">
                            <input id="az_pdpa" type="checkbox" class="form-check-input s_website_form_input"
                                   name="ยินยอมให้เก็บข้อมูลส่วนบุคคล" value="ยินยอม" required=""/>
                            <label class="form-check-label" for="az_pdpa">
                                ยินยอมให้บริษัทเก็บและใช้ข้อมูลส่วนบุคคลเพื่อพิจารณารับสมัครงาน
                                [ข้อความ PDPA ของบริษัท — ให้ HR / ฝ่ายกฎหมายแก้]
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
