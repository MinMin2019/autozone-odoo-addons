<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_resignation_form" model="ir.ui.view">
        <field name="name">hr.resignation.form</field>
        <field name="model">hr.resignation</field>
        <field name="arch" type="xml">
            <form string="ใบลาออก FM-HR-27">
                <header>
                    <button name="action_submit" type="object" string="ส่งใบลาออก" class="btn-primary"
                            invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" type="object" string="อนุมัติ / ลงชื่อ" class="btn-primary"
                            invisible="state not in ('manager', 'gm', 'hr', 'md')"/>
                    <button name="action_reject" type="object" string="ไม่อนุมัติ"
                            invisible="state not in ('manager', 'gm', 'hr', 'md')" confirm="ไม่อนุมัติใบลาออกนี้?"/>
                    <button name="action_register_departure" type="object" string="ลงลาออกในระบบ" class="btn-primary"
                            invisible="state != 'approved'" groups="hr.group_hr_user"/>
                    <button name="action_reset_draft" type="object" string="แก้ไขส่งใหม่"
                            invisible="state not in ('rejected', 'cancel')"/>
                    <button name="action_cancel" type="object" string="ยกเลิก" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,manager,gm,hr,md,approved,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not is_my_turn">
                        <strong>ใบลาออกนี้รอคุณลงชื่อ</strong>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'approved' or checklist_complete">
                        แบบสำรวจคืนของยังไม่ครบ — ตรวจในแท็บ "บันทึกแบบสำรวจพนักงานลาออก" ก่อนลงลาออกในระบบ
                    </div>
                    <div class="oe_title">
                        <span class="text-muted">ใบลาออก</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="registration_number"/>
                            <field name="job_title"/>
                            <field name="department_id"/>
                            <field name="branch" invisible="not branch"/>
                        </group>
                        <group>
                            <field name="date_written" readonly="state not in ('draft', 'rejected')"/>
                            <field name="date_effective" readonly="state not in ('draft', 'rejected')"/>
                            <field name="date_last_day" readonly="state not in ('draft', 'rejected')"/>
                            <field name="manpower_request_id" invisible="not manpower_request_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state not in ('draft', 'rejected')"/>
                    </group>
                    <notebook>
                        <page string="ผู้ลงนาม" name="sign">
                            <group>
                                <group>
                                    <field name="manager_user_id"/>
                                    <field name="manager_date"/>
                                    <field name="gm_user_id"/>
                                    <field name="gm_date"/>
                                </group>
                                <group>
                                    <field name="hr_user_id"/>
                                    <field name="hr_date"/>
                                    <field name="md_user_id"/>
                                    <field name="md_date"/>
                                </group>
                            </group>
                            <div class="text-muted">ผู้จัดการ / GM / กรรมการผู้จัดการ หาจากผังองค์กรของแผนกพนักงานตอนกดส่ง คนเดียวกันหลายขั้นลงชื่อครั้งเดียว</div>
                        </page>
                        <page string="บันทึกแบบสำรวจพนักงานลาออก" name="checklist">
                            <group string="ส่วน HR">
                                <group>
                                    <field name="uniform_shirt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="uniform_shirt_qty" invisible="uniform_shirt != 'not_returned'"/>
                                    <field name="uniform_pants" widget="radio" options="{'horizontal': true}"/>
                                    <field name="uniform_pants_qty" invisible="uniform_pants != 'not_returned'"/>
                                    <field name="probation_tshirt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="probation_tshirt_qty" invisible="probation_tshirt != 'not_returned'"/>
                                </group>
                                <group>
                                    <field name="safety_shoes" widget="radio" options="{'horizontal': true}"/>
                                    <field name="safety_shoes_qty" invisible="safety_shoes != 'not_returned'"/>
                                    <field name="igarage_user" widget="radio" options="{'horizontal': true}"/>
                                    <field name="hr_checker_id"/>
                                    <field name="hr_check_date"/>
                                </group>
                            </group>
                            <group string="ส่วนบัญชี/ทรัพย์สิน">
                                <group>
                                    <field name="tools" widget="radio" options="{'horizontal': true}"/>
                                    <field name="tools_qty" invisible="tools != 'not_returned'"/>
                                    <field name="other_expense" widget="radio" options="{'horizontal': true}"/>
                                </group>
                                <group>
                                    <field name="acc_checker_id"/>
                                    <field name="acc_check_date"/>
                                </group>
                            </group>
                            <field name="other_expense_detail" invisible="other_expense != 'has'" placeholder="รายละเอียดค่าใช้จ่าย"/>
                            <field name="checklist_complete" invisible="1"/>
                        </page>
                    </notebook>
                    <field name="is_my_turn" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_manpower_request_form_resignation" model="ir.ui.view">
        <field name="name">hr.manpower.request.form.resignation</field>
        <field name="model">hr.manpower.request</field>
        <field name="inherit_id" ref="autozone_hr_recruitment.view_manpower_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='replace_employee_ids']" position="after">
                <field name="resignation_id" invisible="not resignation_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_resignation_list" model="ir.ui.view">
        <field name="name">hr.resignation.list</field>
        <field name="model">hr.resignation</field>
        <field name="arch" type="xml">
            <list string="ใบลาออก">
                <field name="name"/>
                <field name="registration_number"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_written"/>
                <field name="date_last_day"/>
                <field name="checklist_complete" string="สำรวจครบ"/>
                <field name="state" widget="badge" decoration-info="state in ('manager', 'gm', 'hr', 'md')"
                       decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_resignation_search" model="ir.ui.view">
        <field name="name">hr.resignation.search</field>
        <field name="model">hr.resignation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="department_id" operator="child_of"/>
                <filter string="รออนุมัติ" name="pending" domain="[('state', 'in', ('manager', 'gm', 'hr', 'md'))]"/>
                <filter string="อนุมัติแล้ว รอลงลาออก" name="approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter string="สถานะ" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="แผนก" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="เดือนที่ออก" name="group_month" context="{'group_by': 'date_last_day:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_resignation" model="ir.actions.act_window">
        <field name="name">ใบลาออก</field>
        <field name="res_model">hr.resignation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">บันทึกใบลาออก FM-HR-27</p>
            <p>ส่งแล้วระบบให้ผู้จัดการ → GM → แผนกบุคคล → กรรมการผู้จัดการ ลงชื่อตามลำดับ แล้วลงลาออกในระบบได้จากใบลาออก</p>
        </field>
    </record>
</odoo>
