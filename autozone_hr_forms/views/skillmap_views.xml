<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ตั้งค่า: หัวข้อ Skill / Task ต่อตำแหน่ง -->
    <record id="view_skillmap_task_list" model="ir.ui.view">
        <field name="name">hr.skillmap.task.list</field>
        <field name="model">hr.skillmap.task</field>
        <field name="arch" type="xml">
            <list string="หัวข้อ Skill / Task" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="job_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_skillmap_task_search" model="ir.ui.view">
        <field name="name">hr.skillmap.task.search</field>
        <field name="model">hr.skillmap.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="name"/>
                <group expand="1" string="จัดกลุ่ม">
                    <filter string="ตำแหน่งงาน" name="group_job" context="{'group_by': 'job_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_skillmap_task" model="ir.actions.act_window">
        <field name="name">ตั้งค่า Skill Map (หัวข้อต่อตำแหน่ง)</field>
        <field name="res_model">hr.skillmap.task</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_job': 1}</field>
    </record>

    <!-- การประเมินแต่ละครั้ง -->
    <record id="view_skillmap_eval_form" model="ir.ui.view">
        <field name="name">hr.skillmap.evaluation.form</field>
        <field name="model">hr.skillmap.evaluation</field>
        <field name="arch" type="xml">
            <form string="แบบประเมินทักษะ Skill Map FM-HR-14">
                <header>
                    <button name="action_done" type="object" string="ยืนยันผลประเมิน" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="แก้ไข" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state == 'done'"/>
                            <field name="registration_number"/>
                            <field name="date_start_work"/>
                            <field name="department_id"/>
                            <field name="job_id" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="round_no"/>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="evaluator_id" readonly="state == 'done'"/>
                            <field name="score"/>
                            <field name="level"/>
                            <field name="probation_pass"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom" create="true">
                            <field name="task_id" domain="[('job_id', '=', parent.job_id)]"/>
                            <field name="score"/>
                            <field name="level" decoration-success="passed" decoration-danger="not passed"/>
                            <field name="passed" column_invisible="True"/>
                        </list>
                    </field>
                    <div class="text-muted small">
                        A 90–100% · B 75–89% (ผ่าน) · C 50–74% · D 25–49% (ไม่ผ่าน) · E 0–24% อยู่ระหว่างอบรม —
                        เป้าผ่านทดลองงาน Skill ≥ 75% · ประเมินอย่างน้อย 2 ครั้ง/ปี
                    </div>
                    <group>
                        <field name="note" placeholder="กรณีมีพนักงานสับเปลี่ยน / โยกย้าย ให้ระบุ"/>
                    </group>
                    <field name="company_id" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_skillmap_eval_list" model="ir.ui.view">
        <field name="name">hr.skillmap.evaluation.list</field>
        <field name="model">hr.skillmap.evaluation</field>
        <field name="arch" type="xml">
            <list string="Skill Map">
                <field name="registration_number"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="round_no"/>
                <field name="date"/>
                <field name="score"/>
                <field name="level" widget="badge" decoration-success="level in ('A', 'B')" decoration-danger="level in ('C', 'D')"/>
                <field name="probation_pass" optional="show"/>
                <field name="evaluator_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_skillmap_eval_search" model="ir.ui.view">
        <field name="name">hr.skillmap.evaluation.search</field>
        <field name="model">hr.skillmap.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id" operator="child_of"/>
                <filter string="ไม่ผ่าน (C, D, E)" name="not_pass" domain="[('level', 'in', ('C', 'D', 'E'))]"/>
                <filter string="ยังไม่ถึงเป้าทดลองงาน" name="below_target" domain="[('probation_pass', '=', False)]"/>
                <filter string="ปีนี้" name="this_year" domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter string="ตำแหน่งงาน" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="หน่วยงาน" name="group_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_skillmap_eval" model="ir.actions.act_window">
        <field name="name">ประเมิน Skill Map</field>
        <field name="res_model">hr.skillmap.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- SKILL MAP CHART: พนักงาน × หัวข้อ, คะแนนครั้งล่าสุด -->
    <record id="view_skillmap_line_pivot" model="ir.ui.view">
        <field name="name">hr.skillmap.evaluation.line.pivot</field>
        <field name="model">hr.skillmap.evaluation.line</field>
        <field name="arch" type="xml">
            <pivot string="Skill Map Chart" disable_linking="False">
                <field name="employee_id" type="row"/>
                <field name="task_id" type="col"/>
                <field name="score" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_skillmap_line_search" model="ir.ui.view">
        <field name="name">hr.skillmap.evaluation.line.search</field>
        <field name="model">hr.skillmap.evaluation.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_id"/>
                <field name="employee_id"/>
                <field name="department_id" operator="child_of"/>
                <filter string="ปีนี้" name="this_year" domain="[('date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter string="ครั้งที่" name="group_round" context="{'group_by': 'round_no'}"/>
                    <filter string="ระดับ" name="group_level" context="{'group_by': 'level'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_skillmap_chart" model="ir.actions.act_window">
        <field name="name">Skill Map Chart</field>
        <field name="res_model">hr.skillmap.evaluation.line</field>
        <field name="view_mode">pivot</field>
        <field name="context">{'search_default_this_year': 1}</field>
    </record>
</odoo>
