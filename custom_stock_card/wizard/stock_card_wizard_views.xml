<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Wizard ================= -->
    <record id="view_stock_card_wizard_form" model="ir.ui.view">
        <field name="name">stock.card.wizard.form</field>
        <field name="model">stock.card.wizard</field>
        <field name="arch" type="xml">
            <form string="บัญชีคุมสินค้า (Stock Card)">
                <group>
                    <group string="ช่วงเวลา">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group string="ขอบเขต">
                        <field name="warehouse_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="ทุกสาขา"/>
                        <field name="categ_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="ทุกหมวด"/>
                        <field name="product_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="ทุกสินค้า"/>
                    </group>
                </group>
                <group string="ตัวเลือก">
                    <field name="kind_filter"/>
                    <field name="split_by_location"/>
                    <field name="include_non_storable"/>
                    <field name="hide_zero"/>
                </group>
                <div class="text-muted small">
                    มูลค่าต่อบรรทัด = จำนวน × ต้นทุนที่ระบบบันทึกไว้กับรายการนั้น (valuation layer)
                    ถ้ารายการไม่มี layer (เช่น โอนระหว่างสาขา) ใช้ต้นทุนปัจจุบันของสินค้า
                    <br/>
                    รับ/จ่ายแยก 9 ประเภท — ส่งขายราคา 0 บาทนับเป็น "เบิกใช้" ไม่ใช่ "ขาย",
                    ของผ่านคลังพักระหว่างทางนับเป็น "โอนเข้า/โอนออก"
                </div>
                <footer>
                    <button name="action_view" string="ดูรายงาน" type="object" class="btn-primary"/>
                    <button name="action_export_xlsx" string="Excel" type="object" class="btn-secondary"/>
                    <button name="action_print_pdf" string="PDF" type="object" class="btn-secondary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_card_wizard" model="ir.actions.act_window">
        <field name="name">บัญชีคุมสินค้า (Stock Card)</field>
        <field name="res_model">stock.card.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_card"
              name="บัญชีคุมสินค้า (Stock Card)"
              parent="stock.menu_warehouse_report"
              action="action_stock_card_wizard"
              sequence="45"/>

    <!-- ================= สรุปต่อสินค้า ================= -->
    <record id="view_stock_card_line_list" model="ir.ui.view">
        <field name="name">stock.card.line.list</field>
        <field name="model">stock.card.line</field>
        <field name="arch" type="xml">
            <list string="บัญชีคุมสินค้า" create="false" edit="false" delete="false"
                  default_order="warehouse_id, location_id, default_code, product_id">
                <field name="warehouse_id" optional="show"/>
                <field name="location_id" optional="show"
                       column_invisible="not context.get('split_by_location')"/>
                <field name="default_code"/>
                <field name="product_name"/>
                <field name="categ_id" optional="hide"/>
                <field name="uom_id"/>
                <field name="opening_qty"/>
                <field name="in_purchase_qty" optional="show"/>
                <field name="in_return_qty" optional="show"/>
                <field name="in_transfer_qty" optional="show"/>
                <field name="in_other_qty" optional="show"/>
                <field name="in_qty" string="รับรวม" optional="hide"/>
                <field name="out_sale_qty" optional="show"/>
                <field name="out_return_qty" optional="show"/>
                <field name="out_transfer_qty" optional="show"/>
                <field name="out_consume_qty" optional="show"/>
                <field name="out_other_qty" optional="show"/>
                <field name="out_qty" string="จ่ายรวม" optional="hide"/>
                <field name="closing_qty" decoration-danger="closing_qty &lt; 0"/>
                <field name="unit_cost" optional="hide"/>
                <field name="opening_value" sum="รวม"/>
                <field name="in_purchase_value" sum="รวม" optional="hide"/>
                <field name="in_return_value" sum="รวม" optional="hide"/>
                <field name="in_transfer_value" sum="รวม" optional="hide"/>
                <field name="in_other_value" sum="รวม" optional="hide"/>
                <field name="in_value" sum="รวม"/>
                <field name="out_sale_value" sum="รวม" optional="hide"/>
                <field name="out_return_value" sum="รวม" optional="hide"/>
                <field name="out_transfer_value" sum="รวม" optional="hide"/>
                <field name="out_consume_value" sum="รวม" optional="hide"/>
                <field name="out_other_value" sum="รวม" optional="hide"/>
                <field name="out_value" sum="รวม"/>
                <field name="closing_value" sum="รวม" decoration-danger="closing_value &lt; 0"/>
                <field name="move_count" optional="hide"/>
                <field name="product_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_stock_card_line_search" model="ir.ui.view">
        <field name="name">stock.card.line.search</field>
        <field name="model">stock.card.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="default_code"/>
                <field name="product_name"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="categ_id"/>
                <filter name="negative" string="ยอดติดลบ" domain="[('closing_qty', '&lt;', 0)]"/>
                <filter name="has_move" string="มีการเคลื่อนไหว" domain="[('move_count', '&gt;', 0)]"/>
                <filter name="no_move" string="ไม่เคลื่อนไหว" domain="[('move_count', '=', 0)]"/>
                <separator/>
                <filter name="f_purchase" string="มีรับซื้อ" domain="[('in_purchase_qty', '!=', 0)]"/>
                <filter name="f_cust_return" string="มีรับคืนจากลูกค้า" domain="[('in_return_qty', '!=', 0)]"/>
                <filter name="f_transfer" string="มีโอนเข้า/ออก" domain="['|', ('in_transfer_qty', '!=', 0), ('out_transfer_qty', '!=', 0)]"/>
                <filter name="f_sale" string="มีขาย" domain="[('out_sale_qty', '!=', 0)]"/>
                <filter name="f_vendor_return" string="มีส่งคืนผู้ขาย" domain="[('out_return_qty', '!=', 0)]"/>
                <filter name="f_consume" string="มีเบิกใช้" domain="[('out_consume_qty', '!=', 0)]"/>
                <filter name="f_other" string="มีปรับปรุงสต็อก/อื่นๆ" domain="['|', ('in_other_qty', '!=', 0), ('out_other_qty', '!=', 0)]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter name="group_warehouse" string="สาขา / คลัง" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_location" string="ตำแหน่ง" context="{'group_by': 'location_id'}"/>
                    <filter name="group_categ" string="หมวดสินค้า" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_product" string="สินค้า" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_stock_card_line_form" model="ir.ui.view">
        <field name="name">stock.card.line.form</field>
        <field name="model">stock.card.line</field>
        <field name="arch" type="xml">
            <form string="บัญชีคุมสินค้า" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="categ_id" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="location_id" readonly="1"
                                   invisible="not location_id"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="unit_cost" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="จำนวน">
                            <field name="opening_qty" readonly="1"/>
                            <field name="in_qty" string="รับรวม" readonly="1"/>
                            <field name="out_qty" string="จ่ายรวม" readonly="1"/>
                            <field name="closing_qty" readonly="1"/>
                        </group>
                        <group string="มูลค่า">
                            <field name="opening_value" readonly="1"/>
                            <field name="in_value" string="มูลค่ารับรวม" readonly="1"/>
                            <field name="out_value" string="มูลค่าจ่ายรวม" readonly="1"/>
                            <field name="closing_value" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="รับเข้า แยกประเภท (จำนวน)">
                            <field name="in_purchase_qty" readonly="1"/>
                            <field name="in_return_qty" readonly="1"/>
                            <field name="in_transfer_qty" readonly="1"/>
                            <field name="in_other_qty" readonly="1"/>
                        </group>
                        <group string="จ่ายออก แยกประเภท (จำนวน)">
                            <field name="out_sale_qty" readonly="1"/>
                            <field name="out_return_qty" readonly="1"/>
                            <field name="out_transfer_qty" readonly="1"/>
                            <field name="out_consume_qty" readonly="1"/>
                            <field name="out_other_qty" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="การเคลื่อนไหว">
                            <field name="move_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="date" widget="date"/>
                                    <field name="reference"/>
                                    <field name="origin" optional="show"/>
                                    <field name="category" optional="show"/>
                                    <field name="kind"/>
                                    <field name="counterpart"/>
                                    <field name="location_id" optional="hide"/>
                                    <field name="location_dest_id" optional="hide"/>
                                    <field name="in_qty"/>
                                    <field name="out_qty"/>
                                    <field name="balance_qty" decoration-danger="balance_qty &lt; 0"/>
                                    <field name="unit_cost"/>
                                    <field name="in_value" sum="รวม"/>
                                    <field name="out_value" sum="รวม"/>
                                    <field name="balance_value"/>
                                    <field name="picking_id" column_invisible="1"/>
                                    <button name="action_open_picking" type="object"
                                            icon="fa-external-link" title="เปิดเอกสาร"
                                            invisible="not picking_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
