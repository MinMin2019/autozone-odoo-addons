<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_az_approval_type_list" model="ir.ui.view">
        <field name="name">az.approval.type.list</field>
        <field name="model">az.approval.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="approver_group_id"/>
                <field name="approver_role_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_az_approval_type_form" model="ir.ui.view">
        <field name="name">az.approval.type.form</field>
        <field name="model">az.approval.type</field>
        <field name="arch" type="xml">
            <form string="ประเภทการอนุมัติข้อมูลหลัก">
                <sheet>
                    <widget name="web_ribbon" title="ปิดใช้งาน" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="approver_group_id"/>
                        <field name="approver_role_ids" widget="many2many_tags"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_az_approval_type" model="ir.actions.act_window">
        <field name="name">ประเภทการอนุมัติ</field>
        <field name="res_model">az.approval.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
