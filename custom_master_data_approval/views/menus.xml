<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mda_partner_queue" model="ir.actions.act_window">
        <field name="name">Vendor/Customer รออนุมัติ</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '=', False), ('approval_state', '!=', 'approved')]</field>
        <field name="context">{'search_default_mda_to_approve': 1}</field>
    </record>

    <record id="action_mda_product_queue" model="ir.actions.act_window">
        <field name="name">สินค้ารออนุมัติ</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', '!=', 'approved')]</field>
        <field name="context">{'search_default_mda_to_approve': 1}</field>
    </record>

    <menuitem id="menu_mda_root" name="อนุมัติข้อมูลหลัก"
              web_icon="contacts,static/description/icon.png"
              sequence="76"
              groups="group_mda_approver_partner,group_mda_approver_product,base.group_system"/>

    <menuitem id="menu_mda_partner_queue" parent="menu_mda_root"
              action="action_mda_partner_queue" sequence="10"
              groups="group_mda_approver_partner,base.group_system"/>

    <menuitem id="menu_mda_product_queue" parent="menu_mda_root"
              action="action_mda_product_queue" sequence="20"
              groups="group_mda_approver_product,base.group_system"/>

    <menuitem id="menu_mda_config" parent="menu_mda_root"
              action="action_az_approval_type" sequence="90"
              groups="base.group_system"/>
</odoo>
