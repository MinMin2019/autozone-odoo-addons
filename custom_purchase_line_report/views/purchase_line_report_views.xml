<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="az_purchase_line_report_list" model="ir.ui.view">
        <field name="name">purchase.order.line.list.az.monthly</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="รายการสั่งซื้อ" create="0" edit="0" delete="0">
                <field name="order_id" string="เลข PO"/>
                <field name="date_order" string="วันที่" widget="date"/>
                <field name="partner_id" string="ผู้ขาย"/>
                <field name="product_id" string="สินค้า"/>
                <field name="product_qty" string="จำนวนสั่ง" sum="รวม"/>
                <field name="qty_received" string="จำนวนรับแล้ว" sum="รวม"/>
                <field name="product_uom" string="หน่วย" optional="show"/>
                <field name="price_unit" string="ราคาต่อหน่วย"/>
                <field name="price_subtotal" string="ยอดรวม (ก่อน VAT)" sum="รวม"/>
                <field name="price_total" string="ยอดรวม (รวม VAT)" sum="รวม" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" string="สถานะ" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="az_purchase_line_report_wizard_form" model="ir.ui.view">
        <field name="name">az.purchase.line.report.wizard.form</field>
        <field name="model">az.purchase.line.report.wizard</field>
        <field name="arch" type="xml">
            <form string="รายการสั่งซื้อรายเดือน">
                <group>
                    <group>
                        <field name="month"/>
                        <field name="year" options="{'format': false}"/>
                    </group>
                    <group>
                        <field name="state_filter" widget="radio"/>
                        <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view" type="object" string="ดูบนจอ" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="btn-secondary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_az_purchase_line_report_wizard" model="ir.actions.act_window">
        <field name="name">รายการสั่งซื้อรายเดือน</field>
        <field name="res_model">az.purchase.line.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_az_purchase_line_report" name="รายการสั่งซื้อรายเดือน"
              parent="purchase.purchase_report_main" action="action_az_purchase_line_report_wizard"
              sequence="55" groups="purchase.group_purchase_user"/>
</odoo>
