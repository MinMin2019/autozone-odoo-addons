<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RFQ dashboard list (Requests for Quotation menu) -->
    <record id="purchase_order_kpis_tree_pending_receipt" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.pending.receipt</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field name="pending_receipt_line_count" string="ค้างรับ (รายการ)" optional="show"
                    invisible="pending_receipt_line_count == 0"
                    decoration-danger="pending_receipt_line_count &gt; 0"/>
            </field>
        </field>
    </record>

    <!-- Purchase Orders list -->
    <record id="purchase_order_view_tree_pending_receipt" model="ir.ui.view">
        <field name="name">purchase.order.view.list.pending.receipt</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field name="pending_receipt_line_count" string="ค้างรับ (รายการ)" optional="show"
                    invisible="pending_receipt_line_count == 0"
                    decoration-danger="pending_receipt_line_count &gt; 0"/>
            </field>
        </field>
    </record>

    <!-- Plain purchase order list -->
    <record id="purchase_order_tree_pending_receipt" model="ir.ui.view">
        <field name="name">purchase.order.list.pending.receipt</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_status" position="after">
                <field name="pending_receipt_line_count" string="ค้างรับ (รายการ)" optional="show"
                    invisible="pending_receipt_line_count == 0"
                    decoration-danger="pending_receipt_line_count &gt; 0"/>
            </field>
        </field>
    </record>

    <!-- Search filter: RFQ search view -->
    <record id="view_purchase_order_filter_pending_receipt" model="ir.ui.view">
        <field name="name">purchase.order.search.pending.receipt</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <filter name="approved" position="after">
                <filter name="pending_receipt" string="มีของค้างรับ"
                    domain="[('state', 'in', ('purchase', 'done')), ('pending_receipt_line_count', '&gt;', 0)]"/>
            </filter>
        </field>
    </record>

    <!-- Search filter: Purchase Orders search view -->
    <record id="purchase_order_view_search_pending_receipt" model="ir.ui.view">
        <field name="name">purchase.order.select.pending.receipt</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <filter name="not_invoiced" position="before">
                <filter name="pending_receipt" string="มีของค้างรับ"
                    domain="[('state', 'in', ('purchase', 'done')), ('pending_receipt_line_count', '&gt;', 0)]"/>
                <separator/>
            </filter>
        </field>
    </record>

</odoo>
