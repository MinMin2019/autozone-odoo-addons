<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- รายงานใบลดหนี้ / ใบกำกับภาษี — พิมพ์ 1 ชุด
             โครง layout เดียวกับใบกำกับ 5 สำเนา (report_invoice_custom.xml) แต่:
             - กล่องชื่อเอกสาร = ใบลดหนี้ / ใบกำกับภาษี
             - กล่องลูกค้าไม่มีคำว่า ขายให้/SOLD TO
             - Doc Info 5 คอลัมน์ (วันที่ / เลขที่ใบลดหนี้ / เลขที่ใบกำกับเดิม / วันที่ใบกำกับเดิม / เหตุผล)
             - ยอดรวม 5 บรรทัดตามข้อกำหนดสรรพากร (get_cn_totals ใน models.py)
             - ลายเซ็น 2 ช่อง (ผู้รับสินค้า / ผู้รับเงิน-ผู้ขาย) ไม่มีรูปลายเซ็น
             - ไม่มีกล่องตัวอักษรบาท / ข้อความเบี้ยปรับ 18% / ป้ายลูกค้า-บัญชี -->
        <template id="report_credit_note_custom">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <!-- 3 ชุด: ชุดแรก ต้นฉบับ, ชุด 2-3 สำเนา (ป้ายอยู่บรรทัดบนสุดในกรอบชื่อเอกสาร) -->
                    <t t-foreach="['ต้นฉบับ (Original)', 'สำเนา (Copy)', 'สำเนา (Copy)']" t-as="copy_label">
                        <t t-call="custom_invoice_print.custom_credit_note_full_layout"
                            t-lang="o.partner_id.lang">
                            <t t-set="cn_copy_label" t-value="copy_label" />
                        </t>
                    </t>
                </t>
            </t>
        </template>

        <template id="custom_credit_note_full_layout">
            <t t-call="web.basic_layout">
                <style>
                    /* @font-face ของ Sarabun ประกาศไว้ที่โมดูล autozone_report_fonts */
                    .page {
                    font-family: Sarabun, 'Droid Sans Fallback', Tahoma, sans-serif;
                    font-size: 13px;
                    color: #000;
                    position: relative;
                    }
                    .signature-footer {
                    width: 100%;
                    margin-top: 25px;
                    page-break-inside: avoid;
                    }
                    .items-table tbody tr { page-break-inside: avoid; }
                </style>

                <div class="page">
                    <!-- ทุกหน้าพิมพ์หัวบิล (logic เดียวกับใบกำกับ 5 ใบ) — หัวบิลกิน 13 แถว
                         ทุกหน้า, footer ใบลดหนี้สูงกว่าใบกำกับ 1 แถว (ตารางยอดรวม 5 บรรทัด)
                         -> หน้าไม่มี footer จุ 33, หน้ามี footer จุ 19
                         ตัวเลข 19 ต้องตรงกับบล็อกเติมแถวว่างใน tbody ด้านล่าง -->
                    <t t-set="report_pages" t-value="o.get_report_pages(per_first=33, per_cont=33, per_last=19, per_single=19)" />
                    <t t-foreach="report_pages" t-as="pinfo">
                    <div t-attf-style="#{'page-break-before: always;' if not pinfo_first else ''}">

                    <!-- ===== หัวบิล: แสดงทุกหน้า ===== -->
                    <t t-if="True">

                    <!-- ==================== HEADER ==================== -->
                    <table class="table table-bordered"
                        style="margin-bottom: 15px; border: 1px solid #ffffff;">
                        <tr>
                            <!-- Col 1: Logo -->
                            <td
                                style="width: 1%; white-space: nowrap; padding-right: 15px; vertical-align: middle;">
                                <img t-if="o.company_id.logo"
                                    t-att-src="image_data_uri(o.company_id.logo)"
                                    style="max-height: 55px; width: auto;" alt="Logo" />
                            </td>

                            <!-- Col 2: Company Info -->
                            <td style="vertical-align: middle;">
                                <strong style="font-size: 18px;">
                                    <span t-field="o.company_id.name" />
                                </strong>
                                <div style="font-size: 12px; line-height: 1.3;">
                                    <span t-out="o.company_id.partner_id.get_thai_address()" />
                                    <br />
                                    <span style="font-size: 9px;">Haed Office: 4/2 Moo 6
                                        S.Sukhaphiban 12, T.Bansuan, A.Muangchonburi, Chonburi 20000
                                        Thailand</span>
                                    <br />
                                    <span>Tel: </span>
                                    <span style="font-size: 9px;" t-field="o.company_id.phone" />
                                    <span t-if="o.company_id.vat"> เลขประจำตัวผู้เสียภาษี: <span
                                            style="font-size: 9px;"
                                            t-field="o.company_id.vat" />
                                    </span>
                                </div>
                            </td>

                            <!-- Col 3: Doc Title -->
                            <td style="width: 35%; vertical-align: middle; text-align: right;">
                                <div
                                    style="border: 2px solid #000; padding: 5px 10px; border-radius: 5px; text-align: center; display: block; min-width: 260px; margin-left: auto;">
                                    <!-- ป้ายต้นฉบับ/สำเนา ตัวใหญ่กว่าชื่อเอกสาร (15px) เล็กน้อย -->
                                    <div style="font-size: 17px; font-weight: bold; line-height: 1.2;">
                                        <!-- nbsp นำหน้า กัน wkhtmltopdf ตัด glyph ไทยตัวแรก -->
                                        <span>&#160;</span><span t-esc="cn_copy_label" />
                                    </div>
                                    <div
                                        style="font-family:'Sarabun', sans-serif; font-size:15px; font-weight:600; line-height:1.2; padding-left:4px; white-space:normal;">
                                        <!-- nbsp คร่อมหน้า-หลัง กัน wkhtmltopdf ตัด glyph ไทยตัวแรก -->
                                        <span>&#160;</span><span>ใบลดหนี้ / ใบกำกับภาษี</span><span>&#160;</span>
                                    </div>
                                    <div style="font-size: 10px; font-weight: bold;">
                                        <span>CREDIT NOTE / TAX INVOICE</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- ==================== ADDRESS (ไม่มีคำว่า ขายให้/SOLD TO) ==================== -->
                    <table class="table table-bordered"
                        style="margin-bottom: 10px; border: 1px solid #ffffff">
                        <tr>
                            <td style="width: 49%; padding-right: 5px;">
                                <div
                                    style="border: 1px solid #ccc; padding: 10px; border-radius: 4px; height: 150px;">
                                    <strong t-field="o.partner_id.name" />
                                    <br />
                                    <span style="display:inline-block; padding-left:3px;"><t t-out="o.partner_id.get_thai_address()" /></span>
                                    <br />
                                    <span t-if="o.partner_id.vat">เลขผู้เสียภาษี: <span
                                            t-field="o.partner_id.vat" /><t t-if="o.partner_id.branch" t-out="' ' + o.partner_id.get_thai_branch_display()" />
                                    </span>
                                </div>
                            </td>
                            <td style="width: 2%;"></td>
                            <!-- ไม่มีบล็อกส่งของที่/DELIVERY TO ในใบลดหนี้ -->
                            <td style="width: 49%; padding-right: 5px;"></td>
                        </tr>
                    </table>

                    <!-- ==================== DOC INFO (5 คอลัมน์) ==================== -->
                    <table class="table table-bordered table-sm text-center mb-2"
                        style="border-color: black; font-size: 12px;">
                        <thead class="bg-light">
                            <tr>
                                <th width="13%" class="text-center">วันที่ <br /> Credit Note Date</th>
                                <th width="17%" class="text-center">เลขที่ใบลดหนี้ <br /> Credit Note No.</th>
                                <th width="17%" class="text-center">เลขที่ใบกำกับภาษีเดิม <br /> Original Invoice No.</th>
                                <th width="15%" class="text-center">วันที่ใบกำกับภาษีเดิม <br /> Original Invoice Date</th>
                                <th width="38%" class="text-center">เหตุผลในการลดหนี้ <br /> Credit Note Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <span t-field="o.invoice_date" />
                                </td>
                                <td>
                                    <strong>
                                        <span t-field="o.name" />
                                    </strong>
                                </td>
                                <td>
                                    <span t-if="o.reversed_entry_id" t-field="o.reversed_entry_id.name" />
                                </td>
                                <td>
                                    <span t-if="o.reversed_entry_id" t-field="o.reversed_entry_id.invoice_date" />
                                </td>
                                <td>
                                    <span t-field="o.x_cn_reason" />
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    </t>
                    <!-- ===== จบหัวบิล ===== -->

                    <!-- ==================== BODY (รายการของหน้านี้) ==================== -->
                    <!-- หน้าสุดท้ายเติม "แถวว่าง" ให้ครบจำนวนแถว -> ดันยอดรวม/ลายเซ็นชิดล่าง -->
                    <div>
                        <table class="table table-sm items-table" style="border: 1px solid #fff;">
                            <thead>
                                <tr style="border-bottom: 1px solid #000;">
                                    <th style="border:none; border-right: 1px solid transparent;"
                                        class="text-start">รายการ<br />Description</th>
                                    <th style="border:none;" class="text-end">จำนวน<br />Quantity</th>
                                    <th style="border:none;" class="text-end">ราคาต่อหน่วย<br />Unit
                                        Price</th>
                                    <th style="border:none;" class="text-end">จำนวน (บาท)<br />Amount
                                        (Baht)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- unit = ช่วงของรายการบนหน้านี้ (รายการรายละเอียดยาวอาจถูกหั่น
                                     ข้ามหน้า -> ช่องจำนวน/ราคาแสดงเฉพาะช่วงแรก u['first']) -->
                                <t t-foreach="pinfo['units']" t-as="u">
                                    <t t-set="line" t-value="u['line']" />
                                    <tr t-if="line.display_type == 'product'">
                                        <td style="border:none;">
                                            <t t-if="u['desc']">
                                                <div style="white-space: normal;">
                                                    <t t-foreach="u['desc']" t-as="vin_line">
                                                        <span t-out="line.env['az.font.util'].wrap_cjk(vin_line)" />
                                                        <br />
                                                    </t>
                                                </div>
                                            </t>
                                            <t t-elif="line.x_custom_name">
                                                <span t-out="line.env['az.font.util'].wrap_cjk(line.x_custom_name, nl2br=True)" />
                                            </t>
                                            <t t-elif="line.name">
                                                <span t-out="line.env['az.font.util'].wrap_cjk(line.name, nl2br=True)" />
                                            </t>
                                            <t t-else="">
                                                <span t-out="line.env['az.font.util'].wrap_cjk(line.product_id.name)" />
                                            </t>
                                        </td>
                                        <td style="border:none;" class="text-end">
                                            <span t-if="u['first']"
                                                t-esc="'{:,.2f}'.format(line.quantity)" />
                                        </td>
                                        <td style="border:none;" class="text-end">
                                            <span t-if="u['first']"
                                                t-esc="'{:,.2f}'.format(line.price_unit)" />
                                        </td>
                                        <td style="border:none;" class="text-end">
                                            <span t-if="u['first']"
                                                t-esc="'{:,.2f}'.format(line.price_subtotal)" />
                                        </td>
                                    </tr>

                                    <!-- Section line -->
                                    <tr t-elif="line.display_type == 'line_section'">
                                        <td colspan="4"
                                            style="border:none; font-weight:bold; padding-top:8px;">
                                            <span t-out="line.env['az.font.util'].wrap_cjk(line.name, nl2br=True)" />
                                        </td>
                                    </tr>

                                    <!-- Note line -->
                                    <tr t-elif="line.display_type == 'line_note'">
                                        <td colspan="4"
                                            style="border:none; font-style:italic; color:#555;">
                                            <span t-out="line.env['az.font.util'].wrap_cjk(line.name, nl2br=True)" />
                                        </td>
                                    </tr>

                                </t>

                                <!-- เติมแถวว่างให้หน้าสุดท้ายครบ 19 แถว (per_last = per_single = 19
                                     เพราะทุกหน้ามีหัวบิล — ต้องตรงกับค่าที่ส่งให้ get_report_pages
                                     ด้านบน, นับเป็น "แถวจริง" (pinfo['rows']) ไม่ใช่จำนวนรายการ) -->
                                <t t-if="pinfo_last">
                                    <t t-set="pad" t-value="max(0, 19 - pinfo['rows'])" />
                                    <t t-foreach="range(pad)" t-as="e">
                                        <tr>
                                            <td style="border:none;">&#160;</td>
                                            <td style="border:none;" />
                                            <td style="border:none;" />
                                            <td style="border:none;" />
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- ===== ยอดรวม + ลายเซ็น: แสดงเฉพาะหน้าสุดท้าย ===== -->
                    <t t-if="pinfo_last">
                    <div class="signature-footer">

                        <!-- ==================== TOTALS (5 บรรทัดตามสรรพากร) ==================== -->
                        <t t-set="cn" t-value="o.get_cn_totals()" />
                        <table class="table table-bordered"
                            style="margin-bottom: 20px; border: 1px solid #ffffff; page-break-inside: avoid;">
                            <tr>
                                <td style="width: 55%; padding-right: 20px; vertical-align: top;">
                                </td>
                                <td style="width: 45%;">
                                    <table class="table table-sm table-bordered" style="margin: 0;">
                                        <tr>
                                            <td>มูลค่าตามใบกำกับภาษีเดิม</td>
                                            <td class="text-end">
                                                <span t-esc="'{:,.2f}'.format(cn['original'])" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>มูลค่าที่ถูกต้อง</td>
                                            <td class="text-end">
                                                <span t-esc="'{:,.2f}'.format(cn['correct'])" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>ผลต่าง</td>
                                            <td class="text-end">
                                                <span t-esc="'{:,.2f}'.format(cn['diff'])" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>ภาษีมูลค่าเพิ่ม 7%</td>
                                            <td class="text-end">
                                                <span t-esc="'{:,.2f}'.format(cn['vat'])" />
                                            </td>
                                        </tr>
                                        <tr class="bg-light">
                                            <td>
                                                <strong>จำนวนเงินรวม</strong>
                                            </td>
                                            <td class="text-end">
                                                <strong>
                                                    <span t-esc="'{:,.2f}'.format(cn['total'])" />
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ==================== SIGNATURE (2 ช่อง ไม่มีรูปลายเซ็น) ==================== -->
                        <table
                            style="width: 100%; border-collapse: collapse; border: 1px solid #000; margin-bottom: 10px; page-break-inside: avoid;">
                            <tr>
                                <td
                                    style="width: 50%; border-right: 1px solid #000; vertical-align: top;">
                                    <div
                                        style="height: 160px; position: relative; padding: 5px; text-align: center;">
                                        <div
                                            style="position: absolute; bottom: 5px; left: 0; width: 100%;">
                                            <div
                                                style="border-bottom: 1px dotted #000; width: 60%; margin: 0 auto;"></div>
                                            <div style="margin-top: 3px; font-weight: bold;">
                                                ผู้รับสินค้า</div>
                                            <div style="font-size: 10px; margin-top: 2px;">วันที่
                                                ....... / ....... / .......</div>
                                        </div>
                                    </div>
                                </td>
                                <td style="width: 50%; vertical-align: top;">
                                    <div
                                        style="height: 160px; position: relative; padding: 5px; text-align: center;">
                                        <div
                                            style="position: absolute; bottom: 5px; left: 0; width: 100%;">
                                            <div
                                                style="border-bottom: 1px dotted #000; width: 60%; margin: 0 auto;"></div>
                                            <div style="margin-top: 3px; font-weight: bold;">
                                                ผู้รับเงิน / ผู้ขาย</div>
                                            <div style="font-size: 10px; margin-top: 2px;">วันที่
                                                ....... / ....... / .......</div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                    </div>
                    </t>
                    <!-- ===== จบยอดรวม+ลายเซ็น (หน้าสุดท้าย) ===== -->

                    </div>
                    </t>
                    <!-- ===== จบ loop หน้า ===== -->

                </div>
            </t>
        </template>
    </data>
</odoo>
