<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: ติดตั้งครั้งแรกสร้างให้ หลังจากนั้นบัญชีแก้ใน UI ได้โดย upgrade โมดูลจะไม่เขียนทับ
         company_id = False → ใช้ได้ทุกบริษัทใน DB -->
    <data noupdate="1">

        <!-- 7 วันหลังจากได้รับสินค้า: Odoo คำนวณจากวันที่ใบแจ้งหนี้ (Bill Date)
             ให้บัญชีคีย์ Bill Date = วันที่รับของ due date จึงตรงเงื่อนไขจริง -->
        <record id="payment_term_7d_after_receipt" model="account.payment.term">
            <field name="name">7 วันหลังจากได้รับสินค้า</field>
            <field name="company_id" eval="False"/>
            <field name="note">Payment due within 7 days after receipt of goods</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after',
                'nb_days': 7,
            })]"/>
        </record>

        <record id="payment_term_eom_20" model="account.payment.term">
            <field name="name">20 วัน ไม่รวมเดือนซื้อ (EOM+20)</field>
            <field name="company_id" eval="False"/>
            <field name="note">Payment due 20 days after the end of the month of purchase (EOM + 20)</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after_end_of_month',
                'nb_days': 20,
            })]"/>
        </record>

        <record id="payment_term_eom_30" model="account.payment.term">
            <field name="name">30 วัน ไม่รวมเดือนซื้อ (EOM+30)</field>
            <field name="company_id" eval="False"/>
            <field name="note">Payment due 30 days after the end of the month of purchase (EOM + 30)</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after_end_of_month',
                'nb_days': 30,
            })]"/>
        </record>

        <record id="payment_term_eom_60" model="account.payment.term">
            <field name="name">60 วัน ไม่รวมเดือนซื้อ (EOM+60)</field>
            <field name="company_id" eval="False"/>
            <field name="note">Payment due 60 days after the end of the month of purchase (EOM + 60)</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after_end_of_month',
                'nb_days': 60,
            })]"/>
        </record>

        <!-- โอนเงินก่อนส่งของ: ระบุ due ทันที (0 วัน) — การเรียกเก็บล่วงหน้าจริงทำผ่านขั้นตอนงาน ไม่ใช่สูตรวันครบกำหนด -->
        <record id="payment_term_advance" model="account.payment.term">
            <field name="name">โอนเงินก่อนส่งของ</field>
            <field name="company_id" eval="False"/>
            <field name="note">Advance payment before placing the order</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'delay_type': 'days_after',
                'nb_days': 0,
            })]"/>
        </record>

    </data>
</odoo>
