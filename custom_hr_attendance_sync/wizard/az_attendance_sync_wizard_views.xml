<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_az_attendance_sync_wizard_form" model="ir.ui.view">
        <field name="name">az.attendance.sync.wizard.form</field>
        <field name="model">az.attendance.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="ดึงเวลาจากเครื่องสแกน">
                <div class="alert alert-info" role="status">
                    ดึงเวลาตอกบัตรจากเครื่องสแกนนิ้ว (ฐาน BpControl) เข้าเป็นบันทึกเวลาของ Odoo<br/>
                    ดึงซ้ำช่วงเดิมได้ไม่เกิดข้อมูลซ้ำ — ถ้าต้นทางแก้เวลาย้อนหลัง ระบบจะแก้ตามให้
                </div>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_sync" type="object" string="ดึงข้อมูล" class="btn-primary"/>
                    <button special="cancel" string="ยกเลิก" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_az_attendance_sync_wizard" model="ir.actions.act_window">
        <field name="name">ดึงเวลาจากเครื่องสแกน</field>
        <field name="res_model">az.attendance.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_az_attendance_sync_wizard"
              name="ดึงเวลาจากเครื่องสแกน"
              parent="hr_attendance.menu_hr_attendance_settings"
              action="action_az_attendance_sync_wizard"
              sequence="89"
              groups="hr_attendance.group_hr_attendance_manager"/>

</odoo>
